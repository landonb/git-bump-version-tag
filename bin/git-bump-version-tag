USAGE_ONELINE="\
USAGE: ${PROG_NAME} [ACTIONS...] [OPTIONS...] [<VERSIONTAG>] [--] [<UPSTREAM>] [<COMMIT>]"

print_usage_summary () {
  # Set default scoping patterns, in case git-put-wise not installed.
  # USYNC: Matches latest common_put_wise.sh values.
  # CXREF: https://github.com/DepoXy/git-put-wise#🥨
  #   ~/.kit/git/git-put-wise/lib/common_put_wise.sh
  SCOPING_PREFIX="${SCOPING_PREFIX:-PROTECTED: }"
  PRIVATE_PREFIX="${PRIVATE_PREFIX:-PRIVATE: }"

  USAGE_SUMMARY="
ACTIONS
~~~~~~~

  Combine one or more bump actions:

    M|-M|major
    m|-m|minor
    p|-p|patch
    a|-a|alpha
    l|-l|least
    s|-s|same

  Or specify a different action:

    d|-d|delete
    P|-P|push
    c|-c|current
    x|-x|--check|--verify

    help|--help
    usage|--usage
    version|--version

OPTIONS
~~~~~~~

  Optional bump action options:

    v|-v|v-pre
    V|-V|v-del
"

USAGE_DETAILS="\
DETAILS
~~~~~~~

- BUMP ACTIONS:

    M, -M, major   Bump major version by one

    m, -m, minor   Bump minor version by one

    p, -p, patch   Bump patch version by one

    a, -a, alpha   Bump pre-release version by one
                   - This only works if the pre-release part ends in a number
                   - Use BUMP_PRERELEASE_BASE to set the default prerelease
                     value (defaults: “${BUMP_PRERELEASE_BASE}”)
                     - E.g., given current version 1.2.3, then
                         $ git bump major alpha
                       will create version 2.0.0${BUMP_PRERELEASE_BASE}1
                     - BUMP_PRERELEASE_BASE is ignored if the previous tag
                       is already pre-release, and its value is used instead

    l, -l, least   Bump least part by one (either patch or pre-release)

    s, -s, same    Use current version
                   - Useful if you only tagged locally,
                     and would like to push that tag now
                   - But if you didn't tag the current commit,
                     likely to fail because cannot repeat a version

  The \"least\" option will be assumed if no option and no other action
  is specified (e.g., on a bare \`${PROG_NAME}\`)

  Options can be specified individually or as a classic arg clump
  - E.g., \`git bump minor alpha\` is the same as \`git bump ma\`
  - Though beware if a clump option matches a known remote name, then it's
    assumed to be the <UPSTREAM> argument instead (in which case you cannot
    use the clump format)

- OTHER ACTIONS:

    d, -d, delete  Delete version tag and GitHub release, if exists
                   - Unless specified, uses latest version
                   - Deletes GitHub release first, if exists
                   - Deletes remote version tag next, if exists
                   - Deletes local tag last, if exists
                   - Useful if you messed up — but it's on you to ensure it's
                     not too late to delete a tag you previously published

    P, -P, push    Push tag (default action when not 'delete')

    c, -c, cur, --cur, current, --current
                   Show current project version number
                   - Also show ▼ distance from HEAD if tag on older commit

    --check <bump> Exits 0 if \`${PROG_NAME} <bump>\` would succeed, else 1
                   - Exits 0 if <bump> can be applied to the current commit
                   - Exits 1 if current commit version(s) include same
                     *version type* (normal or pre-release) as <bump>
                     - Note that git-bump lets user apply both version
                       tag types to the same commit, e.g.,
                         first '1.2.3', then '1.2.4-alpha.1'; or
                         first '1.2.4-alpha.1', then '1.2.4';
                       So this lets automation check if current commit is
                       versioned how user wants (normal or pre-release)
                       (Vs. parsing output of failed \`${PROG_NAME} <bump>\`
                        command, which itself is unreliable if UX changes)

    help, --help
                   Print short help
                   - Note that git intercepts \`--help\` and that this
                     project doesn't currently ship a man doc, so
                       \$ git bump-version-tag --help
                       No manual entry for git-bump-version-tag                  

    usage, --usage
                   Print long help (what you're reading)

    version, --version
                   Show application (${PROG_NAME}'s) version number

- BUMP OPTIONS:

    v, -v, v-pre   Use \"v\" tag prefix
                   - Adds v-prefix if previous tag was not v-prefixed

    V, -V, v-del   Remove \"v\" tag prefix
                   - Removes v-prefix if previous tag was v-prefixed

- AUTOMATION OPTIONS:

  These options are useful for automation, namely tig config, to make
  it easy to pass a <COMMIT> but then to indicate whether that ref
  should be used or not:

    A              Pick commit to tag automatically. This is the default
                   behavior when <COMMIT> is not specified, and essentially
                   tells git-bump-version-tag to ignore the <COMMIT> arg.

    h, H           Use \"HEAD\" as <COMMIT> arg (regardless of the <COMMIT>
                   arg passed in).

    S              Use <COMMIT> arg as specified.

  See DepoXy tig config for an example of how these options can be
  used to simplify the otherwise tedious tig config code:

    https://github.com/DepoXy/depoxy/blob/release/home/.config/tig/config-depoxy

ARGUMENTS:

  <VERSIONTAG>
            Use this to specify the next version tag explicitly
            - Useful when versioning for the first time (though
              bump specifiers will bump from 0, so they work, too)
            - Useful for specifying a uniquely-named prerelease version

  <UPSTREAM>
            Specify the remote or remote/branch to use
            - When unset, uses the current branch's upstream configuration
              - If local branch has no upstream, uses remote from
                \`git remote -v\` if only one remote is configured
              - To set an upstream, use \`git branch -u <remote/branch>\`
            - When only the remote is specified, branch name assumed to
              be same as local branch
            - Specify \"-\" to skip remote tag push altogether
            - Usage: You must use \`--\` before the remote name if it
              could be interpreted as an OPTIONS sequence, or if the
              remote name is also a valid version

  <COMMIT>
            Specify commit to tag, either SHA-1 hash, or \"HEAD\"
            - If not specified, defaults to remote branch HEAD commit
            - If \"HEAD\" is specified and git-put-wise is installed,
              this will tag only the most recent \"non-scoped\" local
              commit
              - A non-scoped commit is indicated by a commit message
                with a specific prefix, either PRIVATE_PREFIX (set to
                \"${PRIVATE_PREFIX:-PRIVATE: }\") or SCOPING_PREFIX (set to \"${SCOPING_PREFIX:-PROTECTED: }\")
            - If \"HEAD\", will also push latest commits to remote
              before tagging

OVERRIDES: Set these environment variables for alternative behavior:

  BUMP_PRERELEASE_BASE=\"${BUMP_PRERELEASE_BASE}\"
            Prerelease part prefix, used by a|alpha

  BUMP_REMOTE_BRANCH_NAME=\"${BUMP_REMOTE_BRANCH_NAME}\"
            Name of remote branch whose HEAD commit will be tagged,
            if unable to determine the remote branch automatically
            - By default uses the default branch for the remote for
              the local upstream branch (i.e., looks for 'HEAD branch'
              from \`git remote show <remote>\`), and this environ is
              only used if the default branch is indeterminable

  BUMP_VERBATIM=${BUMP_VERBATIM}
            If true, applies all patch options in the order encountered
            - E.g., if not verbatim, then
                $ git bump Mmp
              will only bump the largest part (major)
              - So version 1.2.3 → 2.0.0
              - But if BUMP_VERBATIM=true, then the version
                increments 1.2.3 → 2.0.0 → 2.1.0 → 2.1.1
              - As stated, the options are applied in order, so
                reversing 'Mmp' to 'pmM' would result in 2.0.0:
                  $ git bump pmM
                would bump 1.2.3 → 1.2.4 → 1.3.0 → 2.0.0
            - Regardless of BUMP_VERBATIM, you are always allowed to mix
              an alpha bump with any of the other parts (major|minor|patch)
              - E.g., if at version 1.2.3, you can easily start a new alpha
                version at 1.2.4-alpha.1, 1.3.0-alpha.1, or 2.0.0-alpha.1
            - (As an aside, we're unclear if BUMP_VERBATIM is very useful)

  SCOPING_PREFIX=\"${SCOPING_PREFIX:-PROTECTED: }\"
  PRIVATE_PREFIX=\"${PRIVATE_PREFIX:-PRIVATE: }\"
            Specifies the commit message prefixes that designate which
            commits should not be published, if git-put-wise is installed
            - Used when <COMMIT> is specified as \"HEAD\"
            - Only works if git-put-wise is installed
              (see note under <COMMIT>, above)
              - You can find git-put-wise at
                https://github.com/DepoXy/git-put-wise#🥨
"
  echo "${USAGE_SUMMARY}"
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

source_deps () {
  # Need Dunamai to normalize for SemVer or PEP 440.
  # CXREF: https://github.com/mtkennerly/dunamai
  insist_cmd 'dunamai' '- PSST: Try: `pipx install dunamai`'

  # Need Perl for fancy SemVer regex.
  insist_cmd 'perl'

  # Ensure coreutils installed.
  insist_cmd 'realpath' '- E.g., `apt install coreutils` or `brew install coreutils`'

  # Load ask_yesnoskip.
  # https://github.com/landonb/sh-ask-yesnoskip
  source_lib "${SHOILERPLATE:-${HOME}/.kit/sh}" "sh-ask-yesnoskip/bin/ask-yesnoskip.sh"

  # Load git_* functions, including
  #   git_branch_name
  #   git_insist_git_repo
  #   git_largest_version_tag
  #   git_remote_exists
  #   git_versions_tagged_for_commit_object
  #   git_tag_remote_verify_commit;
  # and load environs, incl. GITNUBS_RE_VERSPARTS, GITNUBS_RE_SEMVERSPARTS.
  # CXREF: https://github.com/landonb/sh-git-nubs#🌰
  #   ~/.kit/sh/sh-git-nubs/lib/git-nubs.sh
  source_lib "${SHOILERPLATE:-${HOME}/.kit/sh}" "sh-git-nubs/lib/git-nubs.sh"

  # Optional: git-put-wise, for 'identify_scope_ends_at'.
  # CXREF: https://github.com/DepoXy/git-put-wise#🥨
  # - For color support:
  #   ~/.kit/git/git-put-wise/deps/sh-logger/bin/logger.sh
  # - For SCOPING_PREFIX, PRIVATE_PREFIX, etc.:
  #   ~/.kit/git/git-put-wise/lib/common_put_wise.sh
  # - For identify_scope_ends_at:
  #   ~/.kit/git/git-put-wise/lib/dep_scoped_commits.sh
  # - For put_wise_identify_rebase_boundary_and_remotes:
  #   ~/.kit/git/git-put-wise/lib/dep_rebase_boundary.sh
  # SAVVY: common_put_wise.sh requires Bash (it uses `< <()`).
  if command -v git-put-wise > /dev/null; then
    local put_wise_bin="$(dirname -- "$(realpath -- "$(command -v git-put-wise)")")"
    . "${put_wise_bin}/../deps/sh-logger/bin/logger.sh"
    . "${put_wise_bin}/../lib/common_put_wise.sh"
    . "${put_wise_bin}/../lib/dep_scoped_commits.sh"
    . "${put_wise_bin}/../lib/dep_rebase_boundary.sh"
  fi
}

insist_cmd () {
  local cmd_name="$1"
  local install_hint="$2"

  command -v "${cmd_name}" > /dev/null && return || true

  >&2 echo "ERROR: Missing system command ‘${cmd_name}’"
  if [ -n "${install_hint}" ]; then
    >&2 echo "${install_hint}"
  fi

  exit_1
}

source_lib () {
  # For DepoXy users, the project parent directory.
  local depoxy_basedir="$1"
  # As fallback, check deps/ which ships with this project.
  local deps_lib_path="$2"

  local lib_name
  lib_name="$(basename -- "${deps_lib_path}")"

  if command -v "${lib_name}" > /dev/null && . "${lib_name}" \
    || . "${depoxy_basedir}/${deps_lib_path}" 2> /dev/null \
    || . "$(dirname -- "$(realpath -- "$0")")/../deps/${deps_lib_path}" \
  ; then
    return 0
  fi
  
  >&2 echo "ERROR: Cannot determine source path for dependency: ${lib_name}"

  return 1
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

print_git_remote_default_branch_name () {
  local remote_name="$1"

  local branch_names
  local num_branches
  local remote_branch

  # If remote only has one branch, use it.
  branch_names="$(git branch -a --list "${remote_name}/*")"
  num_branches="$(echo "${branch_names}" | wc -l)"

  # Misleading check. If branch_names empty, num_branches actually -eq 1
  # because wc -l counts empty line.
  if [ -z "${branch_names}" ] || [ ${num_branches} -eq 0 ]; then
    >&2 echo "ERROR: No local branches found for remote “${remote_name}”" \
      "Perhaps you need to fetch?"

    return 0
  fi

  if [ ${num_branches} -eq 1 ]; then
    # Avoid network call to verify this is the actual remote default branch.
    # - Just assume it is.
    remote_branch="$(echo "${branch_names}" | sed 's#^.*/##')"
  else
    # Note that git_remote_default_branch is a network call (git remote show),
    # so we try to avoid it. Above, we checked if remote only has one branch.
    # Here we know there are multiple branches.
    # - One last resort to avoid network call: Check environ "config" value.
    branch_names="$( \
      git branch -a --list "${remote_name}/${BUMP_REMOTE_BRANCH_NAME}"
    )"
    if [ -n "${branch_names}" ]; then
      remote_branch="$(echo "${branch_names}" | sed 's#^.*/##')"
    else
      # ALERT: Network call.
      remote_branch="$(git_remote_default_branch "${remote_name}")"
    fi
  fi

  if [ -z "${remote_branch}" ]; then
    >&2 echo "ERROR: No default branch found for remote “${remote_name}”"

    return 1
  fi

  printf "%s" "${remote_branch}"
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

must_remote_exists () {
  local remote_name="$1"

  # Calls get-url (not a network call).
  git_remote_exists "${remote_name}" && return || true

  >&2 echo "ERROR: No remote named “${remote_name}”"

  exit_1
}

# Some CI workflows might version tag automatically,
# so periodically fetch to try to ensure up to date.
# - We could fetch every time, but this is a network
#   operation, and sometimes you're too in the zone
#   to be bothered.
# - MAYBE: Is there a better approach to gating `fetch`?
#
# COPYD: See varied copy of this fcn., `git_fetch_with_backoff`, in DepoXy at:
#   ~/.kit/git/git-put-wise/lib/common_put_wise.sh
# - But with branch name support.

periodically_fetch () {
  local remote_name="$1"

  if is_git_put_wise_sort_and_sign_enabled; then
    # GPW will fetch, and has its own backoff, git_fetch_with_backoff.

    return 0
  fi

  # E.g., "tools.git-bump-version-tag".
  local bump_config_section="tools.${PROG_NAME_FRIENDLY}"
  local bump_config_last_fetch="lastfetch"

  local bump_fetch_period="${BUMP_FETCH_PERIOD:--1 hour}"

  local last_update="$(git config ${bump_config_section}.${bump_config_last_fetch})"

  local do_fetch=true

  if [ -n "${last_update}" ]; then
    if [ ${last_update} -gt $(date -d "${bump_fetch_period}" +'%s') ]; then
      do_fetch=false
    fi
  fi
  
  if ${do_fetch}; then
    # We could `git fetch "${remote_name}" --tags` get tags only,
    # but should update default branch, too.
    git fetch "${remote_name}"

    git config ${bump_config_section}.${bump_config_last_fetch} "$(date +%s)"
  fi
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

parse_version_parts () {
  local curr_version="$1"

  if [ "${curr_version}" = "${PREFLIGHT_ARGS}" ]; then
    
    return 0
  fi

  # See also: GITNUBS_RE_SEMVERSPARTS. Here we use looser regex so we
  # can read any style version and increment any part of it. Then later
  # we'll use the dunamai library to normalize the version according to
  # style.

  # Note the '!' in '\1!', so that `read` parses the string correctly when
  # there is no v-prefix (i.e., ensure there's a word there for `read`).
  # - Use perl, not sed, because there's a Perl-only .*? non-greedy in the regex.
  local partsstr
  partsstr="$(
    perl -pe "s/${GITNUBS_RE_VERSPARTS}/\1! \2 \3 \5 \6 \7/" <<<"${curr_version}"
  )"

  echo "${partsstr}"
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# Sets VERSION_TAG and ACTION_DELETE,
# maybe UPSTREAM_ARG, and/or TAG_COMMIT_ARG,
# and sets REPLAY_ARGS.

must_resolve_user_args () {
  local curr_version="$1"
  shift

  local partsstr
  partsstr="$(parse_version_parts "${curr_version}")"

  local vprefix major minor patch prerelease finalnum

  IFS=' ' read vprefix major minor patch prerelease finalnum <<< "${partsstr}"

  # ${DRY_RUN} && echo "read: v:${vprefix} M:${major} m:${minor}" \
  #   "p:${patch} a:${prerelease} n:${finalnum} (${partsstr})" || true

  local was_prerelease=$(test -n "${prerelease}" && echo true || echo false)

  # Strip the '!' from the v-prefix (which was used to support `read`).
  vprefix="${vprefix%!}"

  local bumped_patch_or_better=false
  local bmajor=false bminor=false bpatch=false balpha=false
  local bump_verbatim="${BUMP_VERBATIM:-false}"
  local bumps_count=0

  add_prefix () {
    vprefix="${GITNUBS_PREFIX:v}"

    add_replay "${_replay_arg:-v}"
  }

  del_prefix () {
    vprefix=""

    add_replay "${_replay_arg:-V}"
  }

  bump_bumps_count () {
    local replay_arg="$1"

    let 'bumps_count += 1'

    add_replay "${replay_arg}"
  }

  bump_major () {
    local replay_arg="${1-M}"

    bump_bumps_count "${replay_arg}"
    ! ${bump_verbatim} && bmajor=true && return || true

    # Note that if var. unset, the let += 1 sets it to 1.
    let 'major += 1'; minor=0; patch=0; prerelease=; finalnum=;
    bumped_patch_or_better=true
  }

  bump_minor () {
    local replay_arg="${1-m}"

    bump_bumps_count "${replay_arg}"
    ! ${bump_verbatim} && bminor=true && return || true

    let 'minor += 1'; patch=0; prerelease=; finalnum=;
    bumped_patch_or_better=true
  }

  bump_patch () {
    local replay_arg="${1-p}"

    bump_bumps_count "${replay_arg}"
    ! ${bump_verbatim} && bpatch=true && return || true

    # Only bump patch if no current alpha. Otherwise just drop alpha.
    if [ -z "${prerelease}" ]; then
      let 'patch += 1'
    fi
    prerelease=
    finalnum=
    bumped_patch_or_better=true
  }

  # What SemVer calls "pre-release".
  bump_alpha () {
    local replay_arg="${1-a}"

    bump_bumps_count "${replay_arg}"
    ! ${bump_verbatim} && balpha=true && return || true

    BUMP_IS_PRERELEASE=true

    if [ -z "${prerelease}" ]; then
      # If no current alpha, must bump patch so new version is < current vers.
      ${bumped_patch_or_better} || let 'patch += 1'
      prerelease="${BUMP_PRERELEASE_BASE:--alpha.}"
      finalnum="1"
    else
      let 'finalnum += 1'
    fi
  }

  bump_least () {
    if ${was_prerelease}; then
      bump_alpha "${_replay_arg+}"
    else
      bump_patch "${_replay_arg+}"
    fi

    add_replay "${_replay_arg:-l}"
  }

  add_replay () {
    local replay_arg="$1"

    if ${end_of_options}; then
      return 0
    fi

    REPLAY_ARGS="${REPLAY_ARGS}${replay_arg}"
  }

  local skip_opts=0
  local n_extra_args=0
  local end_of_options=false
  local tag_commit_adjust=""

  # USYNC: version_tag_environs
  VERSION_TAG=""
  ACTION_CHECK=false
  ACTION_CURRENT=false
  ACTION_DELETE=false
  ACTION_DISTANCE=false
  ACTION_PUSH=false
  ACTION_SAME=false
  BUMP_IS_PRERELEASE=false
  UPSTREAM_ARG=""
  TAG_COMMIT_ARG=""
  # Don't reset VERSION_ARG, so ACTION_DISTANCE can use.
  #  VERSION_ARG=""
  REPLAY_ARGS=""

  while [ $# -gt 0 ]; do
    local cur_arg="$1"
    shift

    if [ -z "${cur_arg}" ]; then

      continue
    fi

    if [ ${skip_opts} -gt 0 ]; then
      if ! ${end_of_options} && [ "${cur_arg}" = '--' ]; then
        # EOP can immediately follow <VERSION> but that's it.
        end_of_options=true
      else
        end_of_options=true
        if [ ${skip_opts} -eq 1 ]; then
          if is_known_remote "${cur_arg}"; then
            skip_opts=2

            UPSTREAM_ARG="${cur_arg}"
          elif is_known_commit_ref "${cur_arg}"; then
            skip_opts=3

            TAG_COMMIT_ARG="$(unpack_commit_ref "${cur_arg}" "${tag_commit_adjust}")"
          else
            >&2 echo "ERROR: Not a known <UPSTREAM> or <COMMIT>: “${cur_arg}”"
            local remote_name
            if remote_name="$(extract_remote_name_from_upstream "${cur_arg}")"; then
              >&2 echo "- Hint: You might need to \`git remote add "${remote_name}" <URL>\`"
            fi

            exit_1
          fi
        elif [ ${skip_opts} -eq 2 ]; then
          skip_opts=3

          if is_known_commit_ref "${cur_arg}"; then
            TAG_COMMIT_ARG="$(unpack_commit_ref "${cur_arg}" "${tag_commit_adjust}")"
          else
            >&2 echo "ERROR: Expected <COMMIT>, not: “${cur_arg}”"

            exit_1
          fi
        else
          # Case: [ ${skip_opts} -ge 3 ]
          >&2 echo "ERROR: Unrecognized argument: “${cur_arg}”"
          >&2 echo "- Or maybe you specified more than one"
          >&2 echo "   <VERSIONTAG>, <UPSTREAM>, or <COMMIT>"
          >&2 echo "See \`${PROG_NAME} help\` for assistance"

          exit_1
        fi
      fi
    elif [ "${cur_arg}" = '--' ]; then
      skip_opts=1

      end_of_options=true
    elif like_a_version "${cur_arg}"; then
      skip_opts=1

      VERSION_ARG="${cur_arg}"
    elif is_known_remote "${cur_arg}"; then
      skip_opts=2

      UPSTREAM_ARG="${cur_arg}"
    elif is_known_commit_ref "${cur_arg}"; then
      skip_opts=3

      TAG_COMMIT_ARG="$(unpack_commit_ref "${cur_arg}" "${tag_commit_adjust}")"
    else
      case "${cur_arg}" in
        s | -s | same)
          ACTION_SAME=true
          VERSION_TAG="${curr_version}"
          add_replay "${_replay_arg:-s}"
          ;;
        d | -d | delete)
          ACTION_DELETE=true
          VERSION_TAG="${curr_version}"
          add_replay "${_replay_arg:-d}"
          ;;
        P | -P | push)
          ACTION_PUSH=true
          add_replay "${_replay_arg:-P}"
          ;;
        c | -c | cur | --cur | current | --current)
          # The currect project version, with distance.
          ACTION_CURRENT=true
          if [ "${curr_version}" = "${PREFLIGHT_ARGS}" ]; then
            # Wait for next call to parse, when curr_version is set.
            add_replay "${_replay_arg:-c}"
          else
            print_current_project_version_with_head_distance "${curr_version}"

            exit_0
          fi
          ;;
        D | -D | dist | --dist | distance | --distance)
          # The currect project version distance only.
          ACTION_DISTANCE=true
          if [ "${curr_version}" = "${PREFLIGHT_ARGS}" ]; then
            # Wait for next call to parse, when curr_version is set.
            add_replay "${_replay_arg:-D}"
          else
            BUMP_DIST_BEHIND_MARK="" \
              print_current_project_version_with_head_distance \
              "${VERSION_ARG:-${curr_version}}"

            exit_0
          fi
          ;;
        x | -x | --check | --verify)
          # Check if <bump> "compatible" with current commit
          # version tag(s), if any.
          ACTION_CHECK=true
          add_replay "${_replay_arg:-x}"
          ;;
        help | --help)
          print_usage ${_include_details:-false}

          exit_0
          ;;
        usage | --usage)
          print_usage ${_include_details:-true}

          exit_0
          ;;
        version | --version)
          # The git-bump-version-tag version.
          print_version

          exit_0
          ;;

        M | -M | major) bump_major ;;
        m | -m | minor) bump_minor ;;
        p | -p | patch) bump_patch ;;
        a | -a | alpha) bump_alpha ;;
        l | -l | least) bump_least ;;
        v | -v | v-pre) add_prefix ;;
        V | -V | v-del) del_prefix ;;

        A | -A) tag_commit_adjust="${BUMP_TAG_COMMIT_ADJUST_AUTO}" ;;
        h | -h) tag_commit_adjust="${BUMP_TAG_COMMIT_ADJUST_HEAD}" ;;
        H | -H) tag_commit_adjust="${BUMP_TAG_COMMIT_ADJUST_HEAD}" ;;
        S | -S) tag_commit_adjust="${BUMP_TAG_COMMIT_ADJUST_PICK}" ;;

        *)
          if [ -z "${cur_arg}" ]; then
            >&2 echo "BWARE: Did you mean to pass an empty argument?"
          fi

          for char in $(echo "${cur_arg#-}" | sed -E -e 's/(.)/\1\n/g'); do
            case ${char} in
              s) ACTION_SAME=true;
                 VERSION_TAG="${curr_version}";
                 add_replay "${_replay_arg:-s}" ;;
              d) ACTION_DELETE=true;
                 VERSION_TAG="${curr_version}";
                 add_replay "${_replay_arg:-d}" ;;
              P) ACTION_PUSH=true;
                 add_replay "${_replay_arg:-P}" ;;
              x) ACTION_CHECK=true;
                 add_replay "${_replay_arg:-x}" ;;
              M) bump_major ;;
              m) bump_minor ;;
              p) bump_patch ;;
              a) bump_alpha ;;
              l) bump_least ;;
              v) add_prefix ;;
              V) del_prefix ;;
              A) tag_commit_adjust="${BUMP_TAG_COMMIT_ADJUST_AUTO}" ;;
              h) tag_commit_adjust="${BUMP_TAG_COMMIT_ADJUST_HEAD}" ;;
              H) tag_commit_adjust="${BUMP_TAG_COMMIT_ADJUST_HEAD}" ;;
              S) tag_commit_adjust="${BUMP_TAG_COMMIT_ADJUST_PICK}" ;;
              *)
                >&2 echo "ERROR: Unrecognized argument: “${cur_arg}”"

                exit_1
                ;;
            esac
          done
      esac
    fi
  done

  # So `add_replay` called from bump_* commands is a no-op.
  end_of_options=true

  if [ -n "${VERSION_TAG}" ]; then
    # Means 'same' and/or 'delete' specified.
    if [ ${bumps_count} -gt 0 ]; then
      >&2 echo "ERROR: Cannot indicate bump (M|m|p|a), and pick 'same' (s) or delete (d)"

      exit_1
    elif ${ACTION_SAME} && [ -n "${VERSION_ARG}" ]; then
      >&2 echo "ERROR: Cannot indicate 'same' (s), and specify <VERSIONTAG>"

      exit_1
    fi
  fi

  if [ -n "${VERSION_ARG}" ]; then
    # Means <VERSIONTAG> specified.
    if [ ${bumps_count} -gt 0 ]; then
      >&2 echo "ERROR: Cannot indicate bump (M|m|p|a), and specify <VERSIONTAG>"

      exit_1
    fi
    # else, we already checked not 'same' and <VERSIONTAG> specified.
    # - But if 'delete' specified, be sure to delete <VERSIONTAG>.

    VERSION_TAG="${VERSION_ARG}"
  fi

  # Set VERSION_TAG if not set, unless ACTION_DELETE or ACTION_SAME,
  # in which case leave it empty.
  if [ -z "${VERSION_TAG}" ] \
    && [ "${VERSION_TAG}" != "${PREFLIGHT_ARGS}" ] \
    && ! ${ACTION_SAME} \
    && ! ${ACTION_DELETE} \
  ; then
    if [ ${bumps_count} -eq 0 ]; then
      # No action (user called naked `git bump-version-tag`). Usage says
      # defaults 'least'.
      bump_least
    fi
    # If bump-verbatim, the version was bumped during arg parsing.
    if ! ${bump_verbatim}; then
      # Ugh, apologies for such a long branch... and long function.

      bump_verbatim=true

      # We could let user bump more than one part, e.g.,
      #
      #   ! ${bmajor} || bump_major
      #   ! ${bminor} || bump_minor
      #   ! ${bpatch} || bump_patch
      #   ! ${balpha} || bump_alpha
      #
      # but that's what VERBATIM_BUMP=true is for: to let
      # user specify their own bump recipe, and we play
      # along.
      #
      # But for most users, we'll be strict and assume
      # they only want to bump on component (like, why
      # do you want to skip versions? If if that's what
      # you really want, use VERBATIM_BUMP).

      local warn_too_many=false
      # BWARE: If `let` result is 0, function exits nonzero.
      # - I.e., this would trigger errexit if bumps_count=1:
      #     ! ${balpha} || let 'bumps_count -= 1'
      ${balpha} && let 'bumps_count -= 1' || true
      [ ${bumps_count} -le 1 ] || warn_too_many=true

      bumps_count=0

      local biggest=""

      # Idea here is we only honor bumping single component.
      if ${bmajor}; then
        bump_major
        biggest="major"
      elif ${bminor}; then
        bump_minor
        biggest="minor"
      elif ${bpatch}; then
        bump_patch
        biggest="patch"
      fi

      # User can always mix alpha bump with any previous bump,
      # so they can easily create next version alpha release.
      if ${balpha}; then
        bump_alpha
        # We'd never use this `biggest`.
        #  biggest="prerelease"
      fi

      if [ ${bumps_count} -eq 0 ]; then
        # Should be impossible path, because bump_least above if ${bumps_count} -eq 0.
        >&2 echo "ERROR: Please specify a bump part (M|m|p|a|l) or choose same (s)"

        exit_1
      elif ${warn_too_many}; then
        >&2 echo "WARNING: Only the biggest normal option will be used (${biggest})"
        ! ${balpha} || >&2 echo "- But we'll also include the specified pre-release bump"
        >&2 echo "- If you want to bump more than one normal part, toggle \`BUMP_VERBATIM=true\`"
        # Otherwise don't specify more than one part (and no need to make this
        # warning message optional).
      fi
    fi

    pdot=""
    [ -z "${patch}" ] || pdot="."

    # ${DRY_RUN} && echo "version_tag: v:${vprefix} M:${major:-0} m:${minor:-0}" \
    #   "?:${pdot} p:${patch} a:${prerelease} n:${finalnum}" || true
    version_tag="${vprefix}${major:-0}.${minor:-0}${pdot}${patch}${prerelease}${finalnum}"

    VERSION_TAG="${version_tag}"
  fi

  if [ "${VERSION_TAG}" != "${PREFLIGHT_ARGS}" ]; then
    ${DRY_RUN} && echo "VERSION_TAG=${VERSION_TAG}" || true
  fi
}

like_a_version () {
  local word="$1"

  echo "${word}" | grep -q -E "${GITNUBS_RE_VERSPARTS}"
}

# Check if remote from <UPSTREAM> arg (UPSTREAM_ARG) is in local config.
is_known_remote () {
  local upstream="$1"

  # "-" means skip remote tag push.
  if [ "${upstream}" = "${BUMP_SKIP_REMOTE}" ]; then

    return 0
  fi

  local remote_name
  remote_name="$(extract_remote_name_from_upstream "${upstream}")" \
    || return 1

  git remote get-url "${remote_name}" > /dev/null 2>&1
}

extract_remote_name_from_upstream () {
  local upstream="$1"

  validate_branch_name "${upstream}" \
    || return 1

  local remote_name
  remote_name="$(git_upstream_parse_remote_name "${upstream}")"

  remote_name="${remote_name:-${upstream}}"

  printf "%s" "${remote_name}"
}

# REFER: man git-check-ref-format
validate_branch_name () {
  local branch_name="$1"

  # Count /'s
  if [ $(printf "%s" "${branch_name}" | tr -cd '/' | wc -c) -gt 1 ]; then

    return 1
  fi

  git check-ref-format --branch "${branch_name}" >/dev/null 2>&1
}

# ***

is_known_commit_ref () {
  local gitref="$1"

  [ "${gitref}" = "${GITNUBS_SPECIAL_TIG_SHA_UNSTAGED}" ] \
    || git_commit_object_name "${gitref}" > /dev/null
}

BUMP_TAG_COMMIT_ADJUST_AUTO="auto"
BUMP_TAG_COMMIT_ADJUST_HEAD="head"
BUMP_TAG_COMMIT_ADJUST_PICK="pick"

unpack_commit_ref () {
  local gitref="$1"
  local tag_commit_adjust="$2"

  if [ "${tag_commit_adjust}" = "${BUMP_TAG_COMMIT_ADJUST_AUTO}" ]; then
    :  # Print nothing, i.e., TAG_COMMIT="", and we'll figure it out.
  elif [ "${tag_commit_adjust}" = "${BUMP_TAG_COMMIT_ADJUST_HEAD}" ]; then
    printf "%s" "HEAD"
  # else, BUMP_TAG_COMMIT_ADJUST_PICK
  elif [ "${gitref}" = "${GITNUBS_SPECIAL_TIG_SHA_UNSTAGED}" ]; then
    printf "%s" "HEAD"
  else
    printf "%s" "${gitref}"
  fi
}

# ***

print_usage () {
  local include_details=${1:-false}

  echo "${USAGE_ONELINE}"

  print_usage_summary

  if ${include_details}; then
    echo "${USAGE_DETAILS}"
  else
    echo "See \`${PROG_NAME} usage\` for complete help"
  fi

  echo
  print_version
}

print_version () {
  echo "${VERSION_FULL}"
}

# ***

print_current_project_version_with_head_distance () {
  local curr_version="$1"

  local best_version=""

  local curr_version_commit=""

  if [ -z "${curr_version}" ]; then
    # ALTLY: Printing empty string seems best. Otherwise we could
    # print "0.0.0", or "0.0.0~<disst>", or just "~<disst>". But
    # none of these seem to be better than empty string.
    # - E.g.,
    #
    #   if [ -z ${BUMP_UNVERSIONED_VERSION+x} ]; then
    #     best_version="${BUMP_UNVERSIONED_VERSION:-0.0.0}"
    #   else
    #     best_version="${BUMP_UNVERSIONED_VERSION}"
    #   fi
    #   curr_version_commit="$(git_first_commit_sha)"
    # Optional value user could have us print instead of empty string.
    best_version="${BUMP_UNVERSIONED_VERSION}"
  else
    best_version="${curr_version}"
    curr_version_commit="$(git_tag_commit_object "${curr_version}")"
  fi

  if ${ACTION_DISTANCE:-false}; then
    if [ -z "${curr_version}" ]; then
      printf "%s" "0"
    else
      # Print number of commits between current version and scoped head.
      git_distance_between_commits_minus_wips "${curr_version_commit}"
    fi
  elif [ -n "${curr_version}" ]; then
    # MAYBE/2024-04-02 00:12: Add branch names, too
    # Print more detailed description, including both distance from
    # current version to scoped head, and from scoped head to HEAD.
    #  local head_id="$(print_head_distance_id "${curr_version_commit}")"
    local head_id="$(print_head_dist_and_ref_name "${curr_version_commit}")"

    echo "${curr_version} at ${head_id}"
  else
    print_no_version_tags_exist
  fi
}

print_no_version_tags_exist () {
  >&2 echo "🤷 No version tags exist"
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# CXREF: SemVer Perl regex, from the source, unaltered.
#   https://semver.org/
#   https://regex101.com/r/Ly7O1x/3/
verify_new_version_semver_compliant () {
  local version_tag="$1"

  local vless_version="$( \
    echo "${version_tag}" | sed "s/^${GITNUBS_PREFIX:v}//"
  )"

  local semver
  semver="$(
    perl -ne "print if /${GITNUBS_RE_SEMVERSPARTS}/" <<<"${vless_version}"
  )"

  if [ -z "${semver}" ]; then
    CHECK_OUTPUT="${CHECK_OUTPUT}\n$(highlight_fail "✗ SemVer regex renouces ‘${vless_version}’")"

    return 1
  else
    CHECK_OUTPUT="${CHECK_OUTPUT}\n$(highlight_pass "✓ SemVer regex approves ‘${vless_version}’")"
  fi
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# Assume *Yes!* when called without stdin attached.
#
# - When this script is run from a terminal, stdin [ -t 0 ] is open and
#   connected to a terminal; but stdout [ -t 1 ] is not connected.
# - When tested directly from the console, both 0 & 1 are terminaled.
# - When run from GitHub Actions, neither are attached to a terminal.
# Short answer: If there's no stdin, we cannot very well be told what to do.

GIT_BUMP_INBIHIT_NO_TTY_WARNING=${GIT_BUMP_INBIHIT_NO_TTY_WARNING:-false}

GITBUMP_USING_PIPED_INPUT=false

ask_yesnoskip_maybe () {
  local the_ask="$1"
  local default_choice="$2"

  isa_tty () { [ -t 0 ]; }

  local retcode=0

  if isa_tty; then
    THE_CHOICE=$(SKIP_PROMPT_NL=true ask_yesnoskip "${the_ask}" "${default_choice}") \
      || retcode=$?
  else
    # Seems tedious, but we'll check if stdin has anything queued,
    # e.g., so user can pipe answers (not that I can think why anyone
    # would ever want to!). Otherwise we'll auto-yes all prompts, e.g.,
    # because user trusts us and has git-bump wired into a CI release
    # workflow.

    # WEIRD: -t 0 doesn't return anything when data being piped, e.g.,
    #   echo "N" | git bump l
    # - So use a nonzero timeout.
    local input_line
    read -t 0.01 input_line

    if [ -z "${input_line}" ]; then
      if ${GITBUMP_USING_PIPED_INPUT}; then
        >&2 echo "ERROR: End of input. Please pipe more answers"
        >&2 echo "- Auto-declining: ${the_ask}? [y/n/s] N"

        return 1
      fi

      if ! ${GIT_BUMP_INBIHIT_NO_TTY_WARNING}; then
        # Only print it once.
        GIT_BUMP_INBIHIT_NO_TTY_WARNING=true

        >&2 echo "OHYEA: Enabling auto-yesser (no tty or input on stdin)"
      fi

      >&2 echo "Auto-yessing: ${the_ask}? [y/n/s] Y"

      THE_CHOICE="y"
    else
      GITBUMP_USING_PIPED_INPUT=true

      THE_CHOICE=$( \
        echo "${input_line}" \
        | SKIP_PROMPT_NL=true ask_yesnoskip "${the_ask}" "${default_choice}"
      ) \
        || retcode=$?

      # Print what we read from the pipe to show input, and to wrap output.
      >&2 echo "${input_line}"
    fi
  fi

  return ${retcode}
}

git_bump_confirm_next () {
  local version_tag="$1"
  local curr_version="$2"

  if ${BMP_RESTRICT_LOCAL:-false}; then
    THE_CHOICE="y"

    return 0
  fi

  local do_what_now=""

  # Because curr_version is commit_version if tag_commit already tagged.
  local latest_version="$(git_largest_version_tag)"

  if [ -z "${curr_version}" ]; then
    do_what_now="create first version tag at"
  elif is_version_lt_version "${version_tag}" "${latest_version}"; then
    do_what_now="backfill tag"
  else
    do_what_now="bump curr “${curr_version}” to"
  fi

  local where_at=" (at ${TAG_COMMIT_NAME})"

  # E.g., "Okay to bump “1.3.2” → “1.3.2-alpha.1”"
  local msg="Okay to ${do_what_now} “${version_tag}”${where_at}"

  local THE_CHOICE
  ask_yesnoskip_maybe "${msg}" "Y"

  [ $? -ne 0 ] && exit_1 || true

  [ "${THE_CHOICE}" != "y" ] && return 1 || return 0
}

git_bump_confirm_normalize () {
  local version_tag="$1"
  local normal_vers="$2"
  local normal_style="$3"

  if ${BMP_NO_NORMALIZE:-false}; then
    THE_CHOICE="n"

    return 1
  fi

  local msg="Want to normalize “${version_tag}” to “${normal_vers}” (${normal_style} style)"

  # WRONG: Don't use local in this fcn:
  #  local THE_CHOICE
  # - REFER: normalize_version checks THE_CHOICE.
  # - And there's no reason we need local on it,
  #   either, other than being communicative about
  #   scope.
  ask_yesnoskip_maybe "${msg}" "N"

  [ $? -eq 0 ] || THE_CHOICE=""

  [ "${THE_CHOICE}" != "y" ] && return 1 || return 0
}

git_bump_confirm_delete () {
  local version_tag="$1"
  local remote_name="${2:-localhost}"

  local msg="Okay to delete “${version_tag}”"

  local head_dist_ref=""
  if [ -n "$(git tag -l --merged HEAD "${version_tag}")" ]; then
    head_dist_ref="$(print_head_dist_and_ref_name "refs/tags/${version_tag}")"
  fi

  if [ -n "${head_dist_ref}" ]; then
    msg="${msg} (at ${head_dist_ref})"
  else
    msg="${msg} (not merged with HEAD)"
  fi

  if [ -n "${remote_name}" ]; then
    msg="${msg} from “${remote_name}”"
  fi

  local THE_CHOICE
  ask_yesnoskip_maybe "${msg}" "Y"

  [ $? -ne 0 ] && exit_1 || true

  [ "${THE_CHOICE}" != "y" ] && return 1 || return 0
}

git_bump_confirm_push () {
  local version_tag="$1"
  local remote_name="$2"
  local tag_commit="$3"
  local upstream_ref="$4"
  local use_put_wise="${5:-false}"

  if ${BMP_RESTRICT_LOCAL:-false}; then
    THE_CHOICE="n"

    return 1
  fi

  local including_msg=""
  if [ -n "${upstream_ref}" ]; then
    # Means we'll push the commits first, then publish the tag.
    local push_distance="$(git_distance_between_commits "${upstream_ref}" "${tag_commit}")"

    local inflector=""
    [ ${push_distance} -eq 1 ] || inflector="s"

    including_msg=" — $(attr_bold)including ${push_distance} commit${inflector}$(attr_reset)"
  fi

  local msg="Okay to push “${version_tag}” to “${remote_name}”${including_msg}"

  local THE_CHOICE
  if ! ${use_put_wise}; then
    ask_yesnoskip_maybe "${msg}" "Y"

    [ $? -ne 0 ] && exit_1 || true
  else
    THE_CHOICE="y"

    >&2 echo "${msg}? [Auto-yessing: defer to put-wise prompts]"
  fi

  [ "${THE_CHOICE}" != "y" ] && return 1 || return 0
}

# ***

git_bump_print_conflict_alert () {
  local version_tag="$1"
  local remote_name="$2"
  local tag_commit="$3"

  echo
  echo "🚨 ATTENTION 🚨: The tag ‘${version_tag}’ on remote ‘${remote_name}’"
  echo "                 refers to a different commit than the local target:"
  echo
  echo "    target tag ref  ${tag_commit}"
  echo "    remote tag ref  ${GNUBS_TAG_COMMIT_OBJECT:-<missing-GNUBS_TAG_COMMIT_OBJECT>}"
  echo
  #
  # `git_tag_remote_verify_commit` sets a global to send back the tag commit ID.
  if [ -z "${GNUBS_TAG_COMMIT_OBJECT}" ]; then
    # Impossible path.
    >&2 echo "ERROR: Expected non-empty remote tag ref (GNUBS_TAG_COMMIT_OBJECT)"
  fi
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

echo_or_eval () {
  ${DRY_RUN:-false} && echo "DRY_RUN: $@" || eval "$@"
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

git_tag_local_add () {
  local version_tag="$1"
  local tag_commit="$2"
  local curr_version="$3"
  local junior_version="$4"

  if ! "${ACTION_PUSH}"; then
    # Note that CURR_VERSION is really COMMIT_VERSION when TAG_COMMIT_ARG
    # is specified, i.e., it's not the actual largest tag version present.
    if [ "${version_tag}" = "${curr_version}" ] \
      || [ "${version_tag}" = "${junior_version}" ] \
    ; then
      echo "✓ Local tag exists"

      return 0
    fi

    # Prompt user to set local tag. Returns zero on Yes, exits
    # on No, or returns nonzero on Skip. But Skip is basically
    # just graceful exit: the only operation remaining pushes
    # the local tag to the remote, but there's no local tag, so.
    git_bump_confirm_next "${version_tag}" "${curr_version}" \
      || exit_1
  fi

  # Note this command tags (scoped) HEAD, as opposed to a specific branch.
  # E.g., we could tag, say, the release branch:
  #   git tag -a ${version_tag} -m "Version: ${version_tag}" "release"
  # but that would probably be confusing to the user. So stick to the
  # current branch.

  insist_git_user_configured

  echo_or_eval "git tag -a \"${version_tag}\" \\
    -m \"Version: ${version_tag#${GITNUBS_PREFIX:v}}\" \\
    \"${tag_commit}\""

  echo "✓ Created local tag"
}

# ***

# When run from CI, Git user unset by default. Up to caller
# (GHA workflow) to set user.email and user.name.
insist_git_user_configured () {
  [ -n "$(git config user.email)" ] \
    && [ -n "$(git config user.name)" ] \
    && return 0 \
    || true

  >&2 echo "ERROR: Please set the Git user.email and user.name"

  exit_1
}

# ***

git_tag_local_delete () {
  local version_tag="$1"

  if ! git_tag_exists "${version_tag}"; then
    echo "✓ Missing local tag"

    return
  fi

  git_bump_confirm_delete "${version_tag}" "" \
    || return 0

  local tag_id="$( \
    git rev-parse --verify --end-of-options refs/tags/${version_tag}
  )"

  # OUTPUTs, e.g.,
  #   Deleted tag '0.0.1' (was e79ce9c)
  # where the ID is the tag ID, not the commit ID.
  local cmd_output
  cmd_output="$( \
    echo_or_eval "git tag -d \"${version_tag}\""
  )"

  if [ $(echo "${cmd_output}" | wc -l) -eq 1 ] \
    && echo "${cmd_output}" | grep -q -e "^Deleted tag " \
  ; then
    echo "✓ Deleted local tag '${version_tag}'" \
      "(was $(git_sha_shorten "${tag_id}"))"
  else
    # Unexpected response.
    echo "${cmd_output}"
  fi
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

github_release_delete () {
  local version_tag="$1"

  if ! gh release view "${version_tag}" > /dev/null 2>&1; then
    return
  fi

  # Don't need to prompt: `gh` has its own.
  #
  #  git_bump_confirm_delete "${version_tag}" "GitHub releases" \
  #    || return 1

  gh release delete "${version_tag}"
}

git_tag_remote_delete () {
  local version_tag="$1"
  local remote_name="$2"

  # (lb): I realize there's a less obtuse syntax to delete tags, e.g.,
  #           git push --delete ${remote_name} ${tag_name}
  #       But that syntax might also delete a branch of the same name.
  #       So be :obtuse, and be specific about what's being deleted.
  # OUTPUTs, e.g.,
  #   To github.com:landonb/git-bump-version-tag.git
  #    - [deleted]         1.3.9
  local cmd_output
  cmd_output="$( \
    echo_or_eval "git push \"${remote_name}\" \":refs/tags/${version_tag}\" 2>&1"
  )"

  if [ $(echo "${cmd_output}" | wc -l) -eq 2 ] \
    && echo "${cmd_output}" | head -n 1 | grep -q -e "^To " \
    && echo "${cmd_output}" | tail -n 1 | grep -q -e "^ - \[deleted\] " \
  ; then
    echo "${cmd_output}" | head -n 1
    echo "✓ Deleted remote tag '${version_tag}'"
  else
    # Unexpected response.
    echo "${cmd_output}"
  fi
}

git_tag_remote_push () {
  local version_tag="$1"
  local tag_commit="$2"
  local remote_name="$3"
  local remote_branch="$4"
  local remote_head_sha="$5"

  # We've already verified the remote name is defined locally:
  #
  #   must_remote_exists "${remote_name}"
  #
  # But we haven't attempted to contact the remote until now,
  # so we don't yet know that it's actually reachable/online.
  #
  # - The `git_tag_remote_verify_commit` function, below,
  #   calls git-ls-remote, which contacts the remote server.

  local verify_result=0

  # Prefix the git_tag_remote_verify_commit output to better
  # distinguish it from other messages.
  #
  #  printf '%s' '- '

  # Delete remote version tag from target commit.
  # - This makes a network call (via git-ls-remote).
  # - This checks if the same version tag exists on the remote,
  #   and if it's applied to the same target commit or not.
  #   - If tag exists and applied to commit, returns GNUBS_TAG_PRESENT (0).
  #   - If tag exists but applied to a different commit,
  #     prompts user to delete that tag from the remote.
  #   - If tag doesn't exist, returns GNUBS_TAG_ABSENT (1).
  #   - On error, returns GNUBS_FAILED (-1).
  # This call outputs "Sending remote request: ..."
  GNUBS_TAG_COMMIT_OBJECT=""
  git_tag_remote_verify_commit "${version_tag}" "${remote_name}" "${tag_commit}" \
    || verify_result=$?

  if [ ${verify_result} -eq ${GNUBS_FAILED} ]; then
    >&2 echo "ERROR: git_tag_remote_verify_commit failed"

    exit_1
  elif [ ${verify_result} -eq ${GNUBS_TAG_CONFLICT} ]; then
    git_bump_print_conflict_alert "${version_tag}" "${remote_name}" "${tag_commit}"

    # Returns 0 on 'Y', 1 on 'S', and will exit app on 'N'.
    # - Return 0 so caller doesn't errexit.
    git_bump_confirm_delete "${version_tag}" "${remote_name}" \
      || return 0

    git_tag_remote_delete "${version_tag}" "${remote_name}"

    verify_result=${GNUBS_TAG_ABSENT}
  fi

  # ***

  if ${ACTION_DELETE}; then
    if [ ${verify_result} -eq ${GNUBS_TAG_PRESENT} ]; then
      # Remove the tag. If the remote is on GitHub, this removes the lightweight
      # (non-annotated) release (e.g., from https://github.com/user/repo/releases)
      # that's automatically generated when the tag was initally applied.
      # - At least that's what I've observed: I'm not quite sure how it works,
      #   or where it's documented, just that deleting the tag clears the entry.
      github_release_delete "${version_tag}"

      git_bump_confirm_delete "${version_tag}" "${remote_name}" \
        || return 0

      git_tag_remote_delete "${version_tag}" "${remote_name}"
    fi

    return 0
  elif [ ${verify_result} -eq ${GNUBS_TAG_PRESENT} ]; then
    # The tag is already pushed.
    echo "✓ Remote already up-to-date"

    return 0
  elif [ ${verify_result} -ne ${GNUBS_TAG_ABSENT} ]; then
    # Impossible path.
    >&2 echo "ERROR: Unexpected verify_result: ${verify_result} (expecting ${GNUBS_TAG_ABSENT})"

    return 1
  fi
  # else, [ ${verify_result} -eq ${GNUBS_TAG_ABSENT} ], so push it.

  # ***

  local skip_push_branch=false

  local upstream_ref=""

  if [ -n "${remote_head_sha}" ]; then
    if git merge-base --is-ancestor "${tag_commit}" "${remote_head_sha}"; then
      skip_push_branch=true
    else
      upstream_ref="${remote_head_sha}"
    fi
  else
    # Assume everything must be pushed.
    upstream_ref="$(git_first_commit_sha)"
  fi

  local use_put_wise=false

  if is_put_wise_push_remote_same "${remote_name}" "${remote_branch}"; then
    use_put_wise=true
  fi

  git_bump_confirm_push \
    "${version_tag}" \
    "${remote_name}" \
    "${tag_commit}" \
    "${upstream_ref}" \
    "${use_put_wise}" \
    || return 0

  # ***

  # If user specified "HEAD" <COMMIT>, push that, too.
  # - Otherwise we're tagging the current remote branch HEAD,
  #   so this push would be meaningless (wasted network call).
  # - By pushing to ${remote_branch}, we ensure that user can
  #   work on that branch locally, tag it, and then push both
  #   the branch commit and the tag simultaneously (we don't
  #   require user to push branch themselves before bumping).
  #   - Note that we previously bailed if ${remote_branch} is
  #     not the same as the local branch.
  if ! ${skip_push_branch}; then
    git_branch_remote_push \
      "${tag_commit}" \
      "${remote_name}" \
      "${remote_branch}" \
      "${use_put_wise}"

    echo "✓ Pushed remote branch"
  fi

  # Let caller specify pre-version-tag-push hook.
  # - Use case: The EAPP project uses this mechanism to push CI tags
  #   to control the workflow that runs when the version tag is pushed.
  #   - CXREF: https://github.com/doblabs/easy-as-pypi#🥧
  # - USAGE:
  #     git-bump-wrapper () {
  #       my_pre_version_tag_push () { ; }
  #       export -f my_pre_version_tag_push
  #       BUMP_PRE_PUSH_HOOK="my_pre_version_tag_push" \
  #         git-bump-version-tag "$@"
  #     }
  if [ -n "${BUMP_PRE_PUSH_HOOK}" ]; then
    eval "${BUMP_PRE_PUSH_HOOK} \"${version_tag}\" \"${tag_commit}\" \"${remote_name}\""
  fi

  # Note that GitHub automatically creates a release for the tag,
  # but it'll be replaced after your CI runs and creates a proper
  # release (well, assuming you have a release workflow tied to a
  # version tag event).
  echo_or_eval "git push \"${remote_name}\" \"refs/tags/${version_tag}\""

  echo "✓ Pushed remote tag"
}

# ***

git_branch_remote_push () {
  local tag_commit="$1"
  local remote_name="$2"
  local remote_branch="$3"
  local use_put_wise="${4:-false}"

  if ${use_put_wise}; then
    # Use --skip-rebase because previously would've called
    #   resort_and_sign_commits_before_push_unless_unnecessary
    # and avoids the but-it's-okay message re: new version tag
    # being within the rebase boundary.
    git put-wise push --skip-rebase
  else
    echo_or_eval git push "\"${remote_name}\" \
      \"${tag_commit}:refs/heads/${remote_branch}\""
  fi
}

# ***

# DEBAR: We could also verify that the remote commit object
# doesn't have "hidden" tags, but it's an unlikely scenario,
# and git-ls-remote is costly (it's a slower network call).
#
# - How you could check: Call `git ls-remote --tag <remote>`,
#   parse results for ${tag_commit}, then examine tag names.
#
#   - Look for version tags, and complain (or fail) if there
#     are more than one version tags, or if the version tag
#     is different from ${version_tag}.
#
#   - We could do this from within the previous function,
#     git_tag_remote_push, e.g., after calling
#     git_tag_remote_verify_commit.
#
# - How you could create the situation: Create a tag, push it,
#   delete it (but not off the remote), create a new version tag
#   at the same commit, and push that tag.
#
#   - Now the remote has two version tags on the same commit.
#
# - This app prevents double-versioning locally in most cases.
#   It'll refuse to run if ${tag_commit} already has a version
#   different than ${version_tag}, except if that ${tag_commit}
#   has a prerelease version, and ${version_tag} is a release.
#   See:
#
#     insist_tag_commit_unversioned_or_same_version_or_opposing_types
#
#   - So the scenario described only happens if the user
#     fails to delete remote tags after deleting locally.
#
# - But it's really not a big deal if there are multiple versions
#   on the same commit. It mostly just looks funny (sloppy).
#
# - Considering all that, and that git-ls-remote is a slower
#   network call, we won't check integrity of tags applied to
#   ${tag_commit} on the remote.
#
#   - But in the call to `git_tag_remote_verify_commit`, we do
#     check the integrity of at least the version tag applied on
#     the remote -- the function fails if the version tag is
#     already applied on the remote, but to a different commit.
#
#     - This is your classic `git push --force` situation,
#       except we don't know which tag is the "correct" tag,
#       be it the local tag, or the remote tag.
#
#     - So we need the user to decide which tag to keep,
#       and which tag to clobber.
#
#   - Another way to reason this:
#     - It's okay to apply more than one version tag to the same commit.
#     - It's not okay to have more than one commit with the same version.
#       - Git won't let this happen in the same repo anyway,
#         but it could happen between two separate repos.
#       - If app sees this, it'll fail to user to resolve the conflict.

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

check_version_tag_lt_later_version () {
  local version_tag="$1"
  local later_version="$2"
  local tag_commit="$3"

  if [ -z "${later_version}" ]; then
    return 0
  fi

  if [ "${version_tag}" = "${later_version}" ]; then
    >&2 echo "ERROR: Version “${version_tag}” already exists" \
      "(since $(git_sha_shorten "${tag_commit}"))"

    return 1
  fi

  if is_version_lt_version "${version_tag}" "${later_version}"; then
    return 0
  fi

  print_versions_out_of_order_error "larger" "behind smaller" \
    "${version_tag}" "${tag_commit}" "${later_version}" \
    " (larger version behind)" " (smaller version ahead)"

  return 1
}

print_versions_out_of_order_error () {
  local lhs_comparator="$1"
  local rhs_comparator="$2"
  local version_tag="$3"
  local tag_commit="$4"
  local conflicts_version="$5"

  lhs_addendum=" (larger version behind)"
  rhs_addendum=" (smaller version ahead)"
  if [ "${lhs_comparator}" = "smaller" ]; then
    local flipflop="${lhs_addendum}"
    lhs_addendum="${rhs_addendum}"
    rhs_addendum="${flipflop}"
  fi

  local conflicts_commit
  conflicts_commit="$(git_tag_commit_object "${conflicts_version}")"

  local pad_width=0
  pad_width="$( \
    { printf "%s" "“${version_tag}”" | wc -c ; 
      printf "%s" "“${conflicts_version}”" | wc -c ;
    } | sort -n | tail -1
  )"
  print_padded () {
    printf "%-${pad_width}s" "$1"
  }

  >&2 echo "ERROR: Cannot apply ${lhs_comparator} version to commit ${rhs_comparator} version"
  >&2 echo "- Apply version: $(print_padded "“${version_tag}”")${lhs_addendum}"
  >&2 echo "  - Dest commit: $(print_head_dist_and_ref_name "${tag_commit}")"
  >&2 echo "- Conlicts with: $(print_padded "“${conflicts_version}”")${rhs_addendum}"
  >&2 echo "  - From commit: $(print_head_dist_and_ref_name "${conflicts_commit}")"
}

# Prints, e.g., 'HEAD~1+6 “publish/release”'
print_head_dist_and_ref_name () {
  local gitref="${1:-HEAD}"
  local friendly="$2"

  if [ $# -lt 2 ]; then
    friendly="$( \
      GITNUBS_LENGTH_SHORT_SHA=7 git_sha_shorten "$(
        git_commit_object_name "${gitref}"
      )"
    )"
  fi

  printf "%s" "$(print_head_distance_id "${gitref}") “${friendly}”"
}

print_head_distance_id () {
  local gitref="${1:-HEAD}"

  local annotated_head=""
  local annotated_scoped=""

  local scoped_head
  scoped_head="$(print_scoped_head)"

  local scoped_distance
  scoped_distance="$(git_distance_between_commits_minus_wips "${gitref}" "${scoped_head}")"

  annotated_head="${BUMP_DIST_BEHIND_MARK:-~}${scoped_distance}"

  if ! git_is_same_commit "${gitref}" "$(git_HEAD_commit_sha)"; then
    local head_distance
    head_distance="$(git_distance_between_commits_minus_wips "${scoped_head}" "HEAD")"

    if [ "${head_distance}" != "0" ]; then
      annotated_scoped="${BUMP_DIST_SCOPED_MARK:-+}${head_distance}"
    elif [ "${scoped_distance}" = "0" ]; then
      annotated_head=""
    fi
  elif [ "${scoped_distance}" = "0" ]; then
    annotated_head=""
  fi

  printf "%s" "HEAD${annotated_head}${annotated_scoped}"
}

git_distance_between_commits_minus_wips () {
  local gitref="$1"
  local head_ref="$2"

  local distance="0"
  local reverse_dist_mark=""

  if [ -z "${head_ref}" ]; then
    head_ref="$(print_scoped_head)"
  fi

  distance="$(git_distance_between_commits "${gitref}" "${head_ref}")"

  if [ ${distance} -eq 0 ]; then
    distance="$(git_distance_between_commits "${head_ref}" "${gitref}")"

    if [ ${distance} -gt 0 ]; then
      reverse_dist_mark="${BUMP_DIST_AHEAD_MARK:-!}"
    fi
  fi

  if git_is_same_commit "${head_ref}" "$(git_HEAD_commit_sha)"; then
    # Delete tag path uses `print_head_dist_and_ref_name` after WIPping.
    ${_STAGED} && let 'distance -= 1'
    ${_WIPPED} && let 'distance -= 1'
  fi

  printf "%s" "${reverse_dist_mark}${distance}"
}

# ***

# WORDS: Per SemVer 2.0.0 doc:
# - A "Normal" version is X.Y.Z form (no prerelease parts), which we use to
#   simplify the comparison (i.e., if X.Y.Z parts don't match, we don't need
#   to compare prerelease parts, which is lots more tedious).
# - A "Version" version (without a qualifier) means full version, whether a
#   Normal version (X.Y.Z) or a Pre-release version (X.Y.Z-*).
# - ALTLY: `man git-config` 'versionsort.suffix' terms: 'base version' and 'suffix'.

# USAGE: Returns 0 if lhs < rhs, or 1 if lhs >= rhs.
is_version_lt_version () {
  local lhs_version="$1"
  local rhs_version="$2"

  if [ "${lhs_version}" = "${rhs_version}" ]; then
    return 1
  fi

  local lhs_normal
  local rhs_normal

  lhs_normal="$(strip_prerelease "${lhs_version}")"
  rhs_normal="$(strip_prerelease "${rhs_version}")"

  # Compare versions without their prerelease parts.
  if [ "${lhs_normal}" != "${rhs_normal}" ]; then
    # The versions don't match at the patch level, so we can compare
    # them without their prerelease parts.
    local smaller_normal="$( \
      echo -e "${lhs_normal}\n${rhs_normal}" \
        | sort -V \
        | head -n1
    )"

    if [ "${smaller_normal}" = "${lhs_normal}" ]; then

      return 0
    fi
  else
    # The versions match at the patch level, so compare prerelease parts.
    local smaller_version="$(
      print_smaller_vers_for_same_patch "${lhs_version}" "${rhs_version}"
    )"

    if [ "${smaller_version}" = "${lhs_version}" ]; then

      return 0
    fi
  fi

  return 1
}

# ***

check_version_tag_gt_earlier_version () {
  local version_tag="$1"
  local earlier_version="$2"
  local tag_commit="$3"
  local alert_fiver="${4:-ERROR}"

  if [ -z "${earlier_version}" ]; then

    return 0
  fi

  if [ "${version_tag}" = "${earlier_version}" ]; then
    if [ -n "${alert_fiver}" ]; then
      earlier_commit="$(git_tag_commit_object "${earlier_version}")"

      local addendum=""
      if [ "${tag_commit}" = "${earlier_commit}" ]; then
        addendum=" (on the same commit — $(print_head_dist_and_ref_name "${tag_commit}"))"
      elif [ -n "${tag_commit}" ]; then
        addendum=" (before $( \
          print_head_dist_and_ref_name "${tag_commit}"
        ) — at $(print_head_dist_and_ref_name "${earlier_commit}"))"
      else
        addendum=" (outside this branch)"
      fi

      >&2 echo "${alert_fiver}: Version “${version_tag}” already exists${addendum}"
    fi

    return 1
  fi

  if is_version_gt_version "${version_tag}" "${earlier_version}"; then

    return 0
  fi

  if [ "${alert_fiver}" = "ERROR" ]; then
    # Caller will exit.
    print_versions_out_of_order_error "smaller" "ahead of larger" \
      "${version_tag}" "${tag_commit}" "${earlier_version}"
  elif [ -n "${alert_fiver}" ] && ! ${ACTION_SAME}; then
    # Recoverable error (earlier_version from outside branch).
    >&2 echo "${alert_fiver}: Found "${earlier_version}" outside branch larger than new version"
    >&2 echo "- Apply version: “${version_tag}”"
    >&2 echo "  - Curr branch: “$(git_branch_name)”"
    >&2 echo "- Conlicts with: “${earlier_version}” (larger version from outside branch)"
    >&2 echo "  - From commit: $(print_head_dist_and_ref_name "${other_commit}")"
  fi

  return 1
}

# ***

# USAGE: Returns 0 if lhs > rhs, or 1 if lhs <= rhs.
is_version_gt_version () {
  local lhs_version="$1"
  local rhs_version="$2"

  if [ "${lhs_version}" = "${rhs_version}" ]; then
    return 1
  fi

  local lhs_normal
  local rhs_normal

  lhs_normal="$(strip_prerelease "${lhs_version}")"
  rhs_normal="$(strip_prerelease "${rhs_version}")"

  # Compare versions without their prerelease parts.
  if [ "${lhs_normal}" != "${rhs_normal}" ]; then
    # The versions don't match at the patch level, so we can compare
    # them without their prerelease parts.
    local smaller_normal="$( \
      echo -e "${lhs_normal}\n${rhs_normal}" \
        | sort -V \
        | head -n1
    )"

    if [ "${smaller_normal}" = "${rhs_normal}" ]; then

      return 0
    fi
  else
    # The versions match at the patch level, so compare prerelease parts.
    local smaller_version="$(
      print_smaller_vers_for_same_patch "${lhs_version}" "${rhs_version}"
    )"

    if [ "${smaller_version}" = "${rhs_version}" ]; then

      return 0
    fi
  fi

  return 1
}

# ***

strip_prerelease () {
  local version_full="$1"

  perl -pe "s/${GITNUBS_RE_VERSPARTS}/\2.\3.\5/" <<<"${version_full}"
}

# ***

# Assumes version through patch level matches, so that it can sort by pre-release parts.
print_smaller_vers_for_same_patch () {
  local lhs_version="$1"
  local rhs_version="$2"

  echo -e "${lhs_version}\n${rhs_version}" \
    | perl -ne "print if s/${GITNUBS_RE_VERSPARTS}/\6, \7, \2.\3.\5\6\7/" \
    | sed '/^$/d' \
    | sort -k1,1r -k2,2n \
    | head -n1 \
    | sed -E "s/^[^,]*, [^,]*, //"
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

insist_tag_commit_unversioned_or_same_version_or_opposing_types () {
  local tag_commit="$1"
  local version_arg="$2"
  local remote_name="$3"
  local remote_branch="$4"

  CURR_VERSION=""
  COMMIT_VERSION=""
  JUNIOR_VERSION=""

  # Caller checks ahead to ensure no version tags appear after this
  # commit, unless scoped head and a PRIVATE/PROTECTED commit is
  # tagged (oops).
  # - Set CURR_VERSION to largest version on tag_commit; or, if none,
  #   to the largest version tag on any commit (on any branch or not).
  #   - Note this means if tag_commit is versioned, CURR_VERSION won't
  #     reflect largest version tag that exists, but we'll warn user on
  #     validate_and_normalize_version if larger version exists.
  local existing_tags
  existing_tags="$(git_versions_tagged_for_commit_object "${tag_commit}")"

  if [ -z "${existing_tags}" ]; then
    CURR_VERSION="$(git_largest_version_tag)"
    # Leave COMMIT_VERSION empty.

    return 0
  fi

  local num_versions="$(echo "${existing_tags}" | wc -l)"

  local curr_version=""

  if ! version_tags_contain "${existing_tags}" "${version_arg}"; then
    # Remember that `wc -l` reports 1 for empty echo's newline,
    # but we already know that [ -n "${existing_tags}" ] is true.
    if [ ${num_versions} -gt 1 ]; then
      if ! (${ACTION_DELETE} || ${ACTION_CURRENT} || ${ACTION_DISTANCE}); then
        if [ -n "${version_arg}" ]; then
          >&2 echo "ERROR: Cannot add “${version_arg}” to commit “${TAG_COMMIT_NAME}”"
        else
          >&2 echo "ERROR: The commit “${TAG_COMMIT_NAME}” is too bloated already"
        fi

        >&2 echo "- This commit already has more than one version tag:"
        echo "${existing_tags}" | >&2 sed 's/^/  /'

        return 1
      fi

      # This is a non-tagging action (delete|--current|--distance),
      # so use largest existing version, regardless of bloatedness.
      curr_version="$(git_largest_version_tag --points-at "${tag_commit}")"
    else
      # There's only one tag on the commit.
      curr_version="${existing_tags}"

      if ! ${ACTION_DELETE} && [ -n "${version_arg}" ]; then
        if ! insist_commit_version_and_new_version_are_not_same_type \
          "${curr_version}" "${version_arg}" \
        ; then

          return 1
        fi
      # else, we'll call insist_commit_version_and_new_version_are_not_same_type later.
      fi
    fi
  else
    # This means version_arg is set, and is tagged on tag_commit.
    curr_version="$(git_largest_version_tag --points-at "${tag_commit}")"
    # - This is a little hacky, or at least feels that way, but
    #   update the CURR_VERSION complementary variable, so that
    #   `git bump <vers>` works on either current version tag.
    if [ "${version_arg}" != "${curr_version}" ]; then
      # CURR_VERSION is set to largest current commit tag.
      # JUNIOR_VERSION is set to a smaller version.
      JUNIOR_VERSION="${version_arg}"
    fi
  fi

  CURR_VERSION="${curr_version}"

  # COMMIT_VERSION refers to existing version on tag_commit.
  COMMIT_VERSION="${CURR_VERSION}"
}

version_tags_contain () {
  local existing_tags="$1"
  local version_tag="$2"

  if [ -z "${version_tag}" ]; then

    return 1
  fi

  local existing_tag
  while IFS= read -r existing_tag; do
    [ -n "${existing_tag}" ] || continue

    if [ "${existing_tag}" = "${version_tag}" ]; then

      return 0
    fi
  done <<< "${existing_tags}"

  return 1
}

# Use case(s) for allowing two versions on the same commit:
# - One pre-release, and one normal.
insist_commit_version_and_new_version_are_not_same_type () {
  local commit_version="$1"
  local version_tag="$2"

  if [ -z "${version_tag}" ]; then

    return 0
  fi

  if [ "${commit_version}" = "${version_tag}" ]; then

    return 0
  fi

  local is_adding_normal=false
  local is_adding_prerelease=false
  local invalid_version=true
  local error_hint=""

  suss_normalities () {
    if is_version_pre_release "${commit_version}"; then
      # Existing version is pre-release.
      if is_version_normal "${version_tag}"; then
        # New version is normal.
        invalid_version=false

        is_adding_normal=true
      else
        # Both versions are pre-release.
        error_hint="- Hint: You can apply a normal version to this commit, but not pre-release"
      fi
    elif is_version_pre_release "${version_tag}"; then
      # New version is pre-release.
      invalid_version=false

      is_adding_prerelease=true
    else
      # Both versions are normal.
      error_hint="- Hint: You can apply a pre-release version to this commit, but not normal"
    fi
  }

  if is_version_gt_version "${version_tag}" "${commit_version}"; then
    # Newer tag greater than existing tag.
    suss_normalities
  else
    # Newer tag less than existing tag.
    # - This envrion here for testing alt. behavior but defaults true.
    if ${BUMP_ALLOW_EARLIER_ALPHA_ON_SAME_COMMIT:-true}; then
      suss_normalities
    else
      error_hint="- Hint: Use a version greater than ${commit_version}"
    fi
  fi

  if ${is_adding_normal}; then
    >&2 echo "BWARE: Double-tagging commit: Adding Normal version to Pre-release"
  elif ${is_adding_prerelease}; then
    >&2 echo "BWARE: Double-tagging commit: Adding Pre-release version to Normal"
  fi

  if ${invalid_version}; then
    >&2 echo "ERROR: The target commit ${TAG_COMMIT_NAME}" \
      "is already version-tagged: ${commit_version}"
    >&2 echo "${error_hint}"

    return 1
  fi
}

# ***

is_version_pre_release () {
  local version_full="$1"

  local version_normal
  version_normal="$(strip_prerelease "${version_full}")"

  [ "${version_full}" != "${version_normal}" ]
}

is_version_normal () {
  local version_full="$1"

  local version_normal
  version_normal="$(strip_prerelease "${version_full}")"

  [ "${version_full}" = "${version_normal}" ]
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

git_wip_staged_if_untidy () {
  local staged=false

  ! git_nothing_staged \
    && git commit -q --no-verify -m "${PRIVATE_PREFIX:-PRIVATE: }WIP (staged) [${PROG_NAME_FRIENDLY}]" > /dev/null \
    && staged=true \
    || true

  printf "%s" "${staged}"
}

# ***

git_wip_commit_if_untidy () {
  local wipped=false

  # If nothing is staged, git-commit fails, but we'll check git-status anyway.
  test -n "$(git status --porcelain=v1)" \
    && git add -A \
    && git commit -q --no-verify -m "${PRIVATE_PREFIX:-PRIVATE: }WIP (untidy) [${PROG_NAME_FRIENDLY}]" > /dev/null \
    && wipped=true \
    || true

  printf "%s" "${wipped}"
}

# ***

git_undo_staged_wip_commit_maybe () {
  if ! ${_STAGED} || ! is_latest_commit_wip_commit; then

    return 0
  fi

  git reset --soft @~1

  _STAGED=false
}

git_pop_wipped_wip_commit_maybe () {
  if ! ${_WIPPED} || ! is_latest_commit_wip_commit; then

    return 0
  fi

  git reset -q --mixed @~1

  _WIPPED=false
}

is_latest_commit_wip_commit () {
  git log -1 --format=%s | grep -q -e "^${PRIVATE_PREFIX:-PRIVATE: }WIP "
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

git_bump_tag_vers_push () {
  # Passed args ($@) from CLI will be passed to and parsed by
  #   must_resolve_user_args

  # Remind user if they're dry-running.
  ${DRY_RUN} && echo "# TEST AHOY! (DRY_RUN=true)" || true

  # ***

  # Insist run from within a Git project.
  git_insist_git_repo || exit_1

  # ***

  # USYNC: version_tag_environs
  local VERSION_TAG=""
  local ACTION_CHECK=false
  local ACTION_CURRENT=false
  local ACTION_DELETE=false
  local ACTION_DISTANCE=false
  local ACTION_PUSH=false
  local ACTION_SAME=false
  local BUMP_IS_PRERELEASE=false
  local UPSTREAM_ARG=""
  local TAG_COMMIT_ARG=""
  local VERSION_ARG=""
  local REPLAY_ARGS=""
  # Parse the user args, and use a placeholder version.
  # - We'll call the parser again after we determine the version
  #   (but we need the other args first to do so).
  local PREFLIGHT_ARGS="-"
  # - Side-effects: The parser sets all the environs listed above.
  must_resolve_user_args "${_curr_version:-${PREFLIGHT_ARGS}}" "$@"

  # ***

  local remote_name
  remote_name="$(resolve_remote_name "${UPSTREAM_ARG}" "${VERSION_TAG}")" \
    || exit_1

  local remote_branch
  local DEFAULT_BRANCH=""
  remote_branch="$(resolve_remote_branch "${remote_name}" "${UPSTREAM_ARG}")" \
    || exit_1

  local remote_head_sha
  remote_head_sha="$(resolve_remote_head_sha "${remote_name}" "${remote_branch}")" \
    || exit_1

  insist_remote_head_is_ancestor_if_set "${remote_name}" "${remote_branch}" \
    || exit_1

  # Target commit, set to CLI arg if set, else remote/branch, or (scoped) HEAD.
  local TAG_COMMIT=""
  # The friendly tag_commit name, for messaging.
  local TAG_COMMIT_NAME=""
  # The largest existing version tag; unless COMMIT_VERSION,
  # then the largest version on TAG_COMMIT.
  local CURR_VERSION=""
  # If TAG_COMMIT has version tags, the largest one.
  local COMMIT_VERSION=""
  # If TAG_COMMIT has multiple version tags, set to VERSION_ARG
  # if VERSION_ARG < CURR_VERSION, so git_tag_local_add can skip
  # git-tag call.
  local JUNIOR_VERSION=""
  must_resolve_tag_commit_and_curr_version \
    "${TAG_COMMIT_ARG}" "${VERSION_ARG}" \
    "${remote_name}" "${remote_branch}" \
    "${remote_head_sha}" "${UPSTREAM_ARG}" \
    || exit_1

  local PW_PUSH_REMOTE_RELEASE=""
  sort_and_sign_and_re_resolve_tag_commit \
    "${remote_name}" "${remote_branch}" \
    "${remote_head_sha}" \
    || exit_1

  # Now that the correct version is identified, replay the bump commands.
  # - If this feels wonky — that we called this function and parsed user
  #   args already — it is. It's an artifact of how the code evolved. But
  #   the status quo is easier and less risky than refactoring the arg
  #   parser. User shouldn't notice anything odd about their UX, at least.
  local upstream="${remote_name}"
  if [ "${remote_name}" != "${BUMP_SKIP_REMOTE}" ] && [ -n "${remote_branch}" ]; then
    upstream="${remote_name}/${remote_branch}"
  fi
  # Set VERSION_TAG per bump commands.
  must_resolve_user_args "${CURR_VERSION}" \
    ${REPLAY_ARGS} ${VERSION_ARG} -- "${upstream}" "${TAG_COMMIT}"

  # ***

  if [ -z ${VERSION_TAG} ]; then
    print_no_version_tags_exist

    exit_1
  elif ${ACTION_CHECK}; then
    validate_and_normalize_version \
      "${TAG_COMMIT}" \
      "${remote_name}" \
      "${remote_branch}" \
      "${_local_head_sha:-$(git_HEAD_commit_sha)}" \
      "${remote_head_sha}" 2> /dev/null
    # Exited on failure. Prints version tag only on success.
    echo "${VERSION_TAG}"
  else
    # Create or delete local and/or remote tags.
    manage_tags "${CURR_VERSION}" "${TAG_COMMIT}" \
      "${remote_name}" "${remote_branch}" \
      "${remote_head_sha}"
  fi
}

resolve_remote_name () {
  local upstream_arg="$1"
  local version_tag="$2"

  local remote_name="${upstream_arg}"

  # Unless skipping remote push, warn if no remote; maybe fetch;
  # and recalculate next version if new version tag was fetched.
  if [ "${remote_name}" != "${BUMP_SKIP_REMOTE}" ]; then
    if [ -n "${remote_name}" ]; then
      local parsed_name
      parsed_name="$(git_upstream_parse_remote_name "${upstream_arg}")"

      remote_name="${parsed_name:-${remote_name}}"
    else
      # Default to the remote tracking branch remote.
      remote_name="$(git_upstream_parse_remote_name 2> /dev/null)" \
        || true
    fi

    # If no such tracking branch, use sole remote if only one set.
    if [ -z "${remote_name}" ]; then
      remote_name="$(resolve_remote_name_from_remotes "${version_tag}")" \
        || return 1
    fi
  fi

  printf "%s" "${remote_name}"
}

resolve_remote_name_from_remotes () {
  local version_tag="$1"

  if [ -n "$(git remote -v)" ]; then
    local push_remotes
    push_remotes="$(git remote -v | grep -e ' (push)$')"

    local num_remotes
    num_remotes=$(echo "${push_remotes}" | wc -l)

    # `wc -l` reports 1 for an empty line, so check nonempty string.
    if [ -z "${push_remotes}" ]; then
      # Should be unreachable path, because outer if `git remote -v` check.
      # - Would mean the grep filtered everything.
      >&2 echo "ERROR: Nothing but push remotes exist?"
      >&2 echo "- Hint: Review \`git remote -v | grep -e ' (push)$'\` and fix this warning"

      remote_name="${BUMP_SKIP_REMOTE}"
    elif [ ${num_remotes} -eq 1 ]; then
      # Just one remote; use it.
      remote_name="$(echo "${push_remotes}" | sed 's/^\([^[:space:]]\+\).*/\1/')"
    else
      # This is the case: [ ${num_remotes} -gt 1 ]
      >&2 echo "ERROR: Branch has no upstream, but more than one remote configured"
      >&2 echo "- Please indicate which upstream to use:"
      >&2 echo "  - You could set a remote tracking branch"
      >&2 echo "    - E.g., if you've already pushed to the remote:"
      >&2 echo "        git branch -u <remote/branch>"
      >&2 echo "    - Or if this is your first push:"
      >&2 echo "        git push -u <remote> <ref>:refs/heads/<branch>"
      >&2 echo "  - Or you could specify the <UPSTREAM> arg, e.g.:"
      >&2 echo "        $( \
        echo "${PROG_NAME} ${REPLAY_ARGS} ${VERSION_ARG} -- <UPSTREAM> ${TAG_COMMIT_ARG}" \
        | sed 's/ \+/ /')"

      if ! (${ACTION_CURRENT} || ${ACTION_DISTANCE}); then
        >&2 echo "Remedy the situation and try again to apply ${version_tag}"

        return 1
      fi

      remote_name="${BUMP_SKIP_REMOTE}"
    fi
  else
    # No remotes. Skip remote dealings.
    remote_name="${BUMP_SKIP_REMOTE}"
  fi

  printf "%s" "${remote_name}"
}

resolve_remote_branch () {
  local remote_name="$1"
  local upstream_arg="$2"

  local remote_branch=""

  if [ "${remote_name}" != "${BUMP_SKIP_REMOTE}" ]; then
    if [ -n "${upstream_arg}" ]; then
      remote_branch="$(git_upstream_parse_branch_name "${upstream_arg}")"
    fi

    # We could defer to the upstream config next...
    #
    #   if [ -z "${remote_branch}" ]; then
    #     remote_branch="$(git_upstream_parse_branch_name 2> /dev/null)" \
    #       || true
    #   fi
    #
    # But it seems better to assume the user expects that each version
    # tag corresponds with a commit in the default branch.
    # - If the user disagrees, they can specify branch via <UPSTREAM>.

    # In most circumstances, user wants to version the default branch HEAD.
    if [ -z "${remote_branch}" ]; then
      remote_branch="$(print_git_remote_default_branch_name "${remote_name}")" \
        || return 1

      DEFAULT_BRANCH="${remote_branch}"
    fi

    ${DRY_RUN} && echo "Remote: ${remote_name}/${remote_branch}" || true
  fi

  printf "%s" "${remote_branch}"
}

insist_remote_head_is_ancestor_if_set () {
  local remote_name="$1"
  local remote_branch="$2"

  if [ -z "${remote_name}" ] || [ -z "${remote_branch}" ]; then

    return 0
  fi

  local scoped_head
  scoped_head="$(print_scoped_head)"

  if ! git merge-base --is-ancestor "${remote_name}/${remote_branch}" "${scoped_head}"; then
    >&2 echo "ERROR: Specified remote/branch not reachable from HEAD:" \
      "“${remote_name}/${remote_branch}” !< $(git_sha_shorten "${scoped_head}")"

    return 1
  fi
}

resolve_remote_head_sha () {
  local remote_name="$1"
  local remote_branch="$2"

  local remote_head_sha=""

  # Unless there are no remotes, user must use "-" to skip this
  # remote check.
  if [ "${remote_name}" != "${BUMP_SKIP_REMOTE}" ]; then
    must_remote_exists "${remote_name}" \
      || return 1

    # Fetch remote at least every hour (network call).
    periodically_fetch "${remote_name}"

    if ! remote_head_sha="$(
      git_remote_branch_object_name "${remote_name}" "${remote_branch}"
    )"; then
      >&2 echo "ERROR: Specified remote/branch not a recognized object:" \
        "“${remote_name}/${remote_branch}”"

      return 1
    fi
  fi

  printf "%s" "${remote_head_sha}"
}

resolve_tag_commit () {
  local tag_commit_arg="$1"
  local remote_name="$2"
  local remote_branch="$3"
  local remote_head_sha="$4"

  # Suss tag_commit from local_head_sha and remote_head_sha.

  local tag_commit=""
  local tag_commit_name=""

  local tag_commit_ref_name=""

  if [ -z "${tag_commit_arg}" ]; then
    if ${ACTION_SAME}; then
      local curr_version="$(git_largest_version_tag)"
      if [ -z "${curr_version}" ]; then
        >&2 echo "ERROR: No existing version tag"

        return 1
      else
        tag_commit="$(git_tag_commit_object "${curr_version}")"
      fi
    elif [ "${remote_name}" != "${BUMP_SKIP_REMOTE}" ] \
      && [ -n "${remote_head_sha}" ] \
    ; then
      # ALERT: Defaults to tagging remote/branch HEAD.
      # - Why? Because git-bump is meant to publish a new version.
      #        But it doesn't want to push unpublished commits. So
      #        it picks the most recent published commit.
      #        - User can override by specifying "HEAD" <COMMIT>.
      tag_commit="${remote_head_sha}"

      tag_commit_ref_name="${remote_name}/${remote_branch}"
    else
      # If git-put-wise installed, exclude PRIVATE/PROTECTED commits;
      # otherwise use HEAD.
      tag_commit="$(print_scoped_head)"
    fi
  elif [ "${tag_commit_arg}" = "HEAD" ]; then
    tag_commit="$(print_scoped_head)"
  else
    tag_commit="$(git_commit_object_name "${tag_commit_arg}")"
  fi

  if [ -n "${tag_commit}" ]; then
    tag_commit_name="$( \
      print_head_dist_and_ref_name "${tag_commit}" ${tag_commit_ref_name}
    )"
  fi

  # Silly multi-value return mechanism (caller ingests by fiddling IFS).
  echo "${tag_commit}"
  echo "${tag_commit_name}"
}

# Inherent, as in, the user didn't specify the remote branch via CLI arg. 
alert_if_inherent_upstream_branch_ne_local_branch_name () {
  local remote_name="$1"
  local remote_branch="$2"
  local upstream_arg="$3"

  # If there's only one remote branch and it's a different name
  # than the local branch; and if the local upstream config does
  # not use the same branch name; and if the user did not specify
  # the branch name explicitly; then alert the user.
  # - This might be unnecessary, but the author assumes this will
  #   rarely happen.
  # - User can avoid this message by specifying the branch name
  #   explicitly via <UPSTREAM>
  if [ "${remote_name}" != "${BUMP_SKIP_REMOTE}" ]; then
    local local_branch="$(git_branch_name)"

    if [ "${remote_branch}" != "${local_branch}" ]; then
      local remote_branch_arg=""
      if [ -n "${upstream_arg}" ]; then
        remote_branch_arg="$(git_upstream_parse_branch_name "${upstream_arg}")"
      fi

      if [ -z "${remote_branch_arg}" ]; then
        local upstream_branch="$(git_upstream_parse_branch_name 2> /dev/null)" \
          || true

        if [ "${remote_branch}" != "${upstream_branch}" ]; then
          local action_msg=""
          if ${ACTION_DELETE}; then
            action_msg="Deleting tag from"
          elif ${ACTION_CURRENT} || ${ACTION_DISTANCE}; then
            action_msg="Checking tags from"
          else
            # I.e., ACTION_PUSH | ACTION_CHECK
            action_msg="Pushing tag to"
          fi

          >&2 echo "ALERT: ${action_msg} differently-named remote branch"
          >&2 echo "- Local branch “${local_branch}” <> “${remote_name}/${remote_branch}”"
          >&2 echo "- You can inhibit this message with explicit <UPSTREAM> arg"
        fi
      fi
    fi
  fi
}

must_resolve_tag_commit_and_curr_version () {
  local tag_commit_arg="$1"
  local version_arg="$2"
  local remote_name="$3"
  local remote_branch="$4"
  local remote_head_sha="$5"
  local upstream_arg="$6"

  TAG_COMMIT=""
  TAG_COMMIT_NAME=""
  CURR_VERSION=""
  JUNIOR_VERSION=""

  local tag_commit=""
  local commit_version=""

  _resolve_tag_commit () {
    local tag_commit_ref="$1"

    # TRCKY: Caller returns multiple values, split by newlines.
    # - Sorta hacky, sort nifty, definitely tricky.
    #
    # - Note that multiple-variable `read` consumer doesn't work
    #   in POSIX/Bash v3, b/c IFS=$'\n' doesn't work as expected.
    #
    #   - E.g., consider Bash v3:
    #
    #     BashV3@macOS $ input=$'line 1\nline 2\nline 3'
    #     BashV3@macOS $ IFS=$'\n' read -d '\n' ln1 ln2 ln3 <<<${input} ; echo $ln1
    #     line 1 line 2 line 3
    #
    #   - Compared to Bash v5:
    #
    #     BashV5@macOS $ IFS=$'\n' read -d '\n' ln1 ln2 ln3 <<<${input} ; echo $ln1
    #     line 1
    #
    #   - Also note that `<<<$()` (or similar `< <()`) is a Bashism (not POSIX).
    #
    # - However, unpacking the output to an array works everywhere, e.g.,
    #
    #     $ /bin/sh
    #     $ input=$'line 1\nline 2\nline 3'
    #     $ IFS=$'\n'
    #     $ arr=($input)
    #     $ IFS=$' \t\n'
    #     $ echo "${arr[0]}"
    #     line 1

    local tag_commit_and_name
    tag_commit_and_name="$( \
      resolve_tag_commit "${tag_commit_ref}" \
        "${remote_name}" "${remote_branch}" \
        "${remote_head_sha}"
    )" || return 1

    declare -a values

    IFS=$'\n'
    values=(${tag_commit_and_name})
    # `man bash` (v3) says IFS "default value is ``<space><tab><newline>''."
    IFS=$' \t\n'

    tag_commit="${values[0]}"
    TAG_COMMIT_NAME="${values[1]}"
  }

  _advance_tag_commit () {
    if [ -z "${TAG_COMMIT_ARG}" ] \
      && [ "${remote_name}" != "${BUMP_SKIP_REMOTE}" ] \
    ; then
      _resolve_tag_commit "HEAD" \
        || return 1
    fi
  }

  # ***

  alert_if_inherent_upstream_branch_ne_local_branch_name \
    "${remote_name}" "${remote_branch}" "${upstream_arg}"

  # Get the tag_commit. It'll be TAG_COMMIT_ARG if set,
  # remote/branch if exists, or falls back scoped HEAD.
  _resolve_tag_commit "${TAG_COMMIT_ARG}" \
    || return 1

  # Identify the largest version tag applied after tag_commit.
  local largest_version_from_ahead="$( \
    git_largest_version_tag --merged HEAD --no-merged "${tag_commit}" \
  )"

  if [ -n "${largest_version_from_ahead}" ]; then
    # In this case, a commit ahead of tag_commit is versioned.
    # - Unless TAG_COMMIT_ARG, switch to HEAD commit instead.
    # Note this means user will be prompted to push commits.
    _advance_tag_commit
  fi

  # ***

  # Check not more than one tag already applied to the target tag_commit,
  # unless version_arg specified, in which case allow two tags if one tag
  # matches version_arg. If one tag exists and version_arg specified,
  # verify that one tag is a normal tag and that the other tag is a
  # pre-release tag (git-bump lets user apply both alpha and normal tags
  # to any commit, in any order).
  # - Sets CURR_VERSION, COMMIT_VERSION, and JUNIOR_VERSION.
  # - If checks fail, or if checks indicate that tag_commit is already
  #   tagged
  # BWARE: DX: You may want to temporarily remote /dev/null to help test.
  if ! insist_tag_commit_unversioned_or_same_version_or_opposing_types \
      "${tag_commit}" "${version_arg}" "${remote_name}" "${remote_branch}" \
      2> /dev/null \
    || ( [ -n "${COMMIT_VERSION}" ] \
      && ! ${ACTION_SAME} \
      && ( [ -z "${TAG_COMMIT_ARG}" ] \
        || ( [ "${version_arg}" != "${CURR_VERSION}" ] \
          && [ "${version_arg}" != "${JUNIOR_VERSION}" ] ) ) ) \
  ; then
    _advance_tag_commit
  fi

  # Caller doesn't expect version compare warnings on --check.
  # - Copy stderr file descriptor to temporary descriptor.
  exec 3>&2
  if ${ACTION_CHECK}; then
    exec 2>/dev/null
  fi
  # Once more with feeling, er, stderr (which we inhibited before because
  # we maybe moved tag_commit forward, in which case those error messages
  # were irrelevant).
  if ! insist_tag_commit_unversioned_or_same_version_or_opposing_types \
    "${tag_commit}" "${version_arg}" "${remote_name}" "${remote_branch}" \
  ; then
    # Restore stderr.
    exec 2>&3

    exit_1
  fi
  # Restore stderr.
  exec 2>&3

  # Warn-tell user if the current version is not under HEAD.
  if [ -n "${CURR_VERSION}" ] \
    && [ -z "$(git tag -l --merged HEAD "${CURR_VERSION}")" ] \
  ; then
    >&2 echo "BWARE: The current version “${CURR_VERSION}”" \
      "is tagged outside the current branch"
  fi

  TAG_COMMIT="${tag_commit}"
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

manage_tags () {
  local curr_version="$1"
  local tag_commit="$2"
  local remote_name="$3"
  local remote_branch="$4"
  local remote_head_sha="$5"

  local default_tag_commit="${tag_commit}"

  # ***

  # Create temporary WIP commit(s) if staged and/or untidy
  _STAGED="$(git_wip_staged_if_untidy)"
  _WIPPED="$(git_wip_commit_if_untidy)"

  # ***

  local local_head_sha="$(git_HEAD_commit_sha)"

  push_or_delete \
    "${tag_commit}" \
    "${remote_name}" \
    "${remote_branch}" \
    "${local_head_sha}" \
    "${remote_head_sha}"

  if ${ACTION_DELETE} && ${ACTION_PUSH}; then
    # This is the special `-dP` use case, which allows user to re-apply
    # a version, i.e., delete the *old* tag from remote and local, and
    # then re-apply same version at new tag_commit.

    ACTION_DELETE=false
    # ACTION_PUSH is implied unless ACTION_DELETE, so setting it false
    # after ACTION_DELET=false would work just the same.
    #  ACTION_PUSH=false

    tag_commit="${default_tag_commit}"

    push_or_delete \
      "${tag_commit}" \
      "${remote_name}" \
      "${remote_branch}" \
      "${local_head_sha}" \
      "${remote_head_sha}"
  fi

  # ***

  git_pop_wipped_wip_commit_maybe
  git_undo_staged_wip_commit_maybe
}

# ***

print_scoped_head () {
  local scoped_head_sha=""

  # Optional: git-put-wise scope logic.
  if ! command -v git-put-wise > /dev/null; then
    scoped_head_sha="$(git_HEAD_commit_sha)"
  else
    # Exclude latest commits whose messages start with "PRIVATE: " or
    # "PROTECTED: ". Use case: So you can keep some stuff private to
    # your local repo without needing to maintain a separate feature
    # branch.
    local release_boundary_or_HEAD
    release_boundary_or_HEAD="$( \
      identify_scope_ends_at "^${SCOPING_PREFIX}" "^${PRIVATE_PREFIX}" \
    )"

    if [ "${release_boundary_or_HEAD}" = "HEAD" ]; then
      scoped_head_sha="$(git_HEAD_commit_sha)"
    else
      scoped_head_sha="${release_boundary_or_HEAD}"
    fi
  fi

  printf "%s" "${scoped_head_sha}"
}

# ***

push_or_delete () {
  local tag_commit="$1"
  local remote_name="$2"
  local remote_branch="$3"
  local local_head_sha="$4"
  local remote_head_sha="$5"

  # SCOPE: Vars. from caller scope:
  #  CURR_VERSION= — Usually git_largest_version_tag, unless TAG_COMMIT
  #   is versioned, then set to largest TAG_COMMIT version.
  #  COMMIT_VERSION= — Set to existing version tag if found on TAG_COMMIT
  #    (so same as CURR_VERSION in that case, otherwise empty).
  #  JUNIOR_VERSION= — If TAG_COMMIT has 2 tags, set to the smaller
  #    version if it's same as VERSION_ARG.

  if ! ${ACTION_DELETE}; then
    validate_and_normalize_version \
      "${tag_commit}" \
      "${remote_name}" \
      "${remote_branch}" \
      "${local_head_sha}" \
      "${remote_head_sha}"

    # Tag the local commit (returns immediately if already tagged).
    git_tag_local_add "${VERSION_TAG}" "${tag_commit}" \
      "${CURR_VERSION}" "${JUNIOR_VERSION}"
  else
    # Set tag_commit to tag commit ID, which we pass to remote delete tag
    # so it can check for conflict (not that it really matters on delete,
    # but could be interesting to user).
    if ! tag_commit="$(git_tag_commit_object "${VERSION_TAG}")"; then
      >&2 echo "🙅 No such version “${VERSION_TAG}”"

      exit_1
    fi
  fi

  if [ "${remote_name}" != "${BUMP_SKIP_REMOTE}" ]; then
    # Delete and/or push the remote tag (and maybe the branch).
    git_tag_remote_push "${VERSION_TAG}" "${tag_commit}" \
      "${remote_name}" "${remote_branch}" \
      "${remote_head_sha}"
  fi

  # Delete locally last, so user doesn't abandon remote tag
  # (well, abandon until the next fetch or pull).
  if ${ACTION_DELETE}; then
    git_tag_local_delete "${VERSION_TAG}"
  fi
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# USAGE: Opt-out git-put-wise using PW_OPTION_SKIP_REBASE=true
# (or don't install git-put-wise).

is_git_put_wise_sort_and_sign_enabled () {
  command -v git-put-wise > /dev/null \
    && ! ${PW_OPTION_SKIP_REBASE:-false}
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

sort_and_sign_and_re_resolve_tag_commit () {
  local remote_name="$1"
  local remote_branch="$2"
  local remote_head_sha="$3"

  if ! is_git_put_wise_sort_and_sign_enabled; then
    # Means PW_OPTION_SKIP_REBASE=true, or git-put-wise not found.

    return 0
  fi

  local REBASE_BOUNDARY=""
  PW_PUSH_REMOTE_RELEASE=""
  local already_sorted=false
  resolve_rebase_boundary

  if ${ACTION_CHECK} || ${ACTION_CURRENT} || ${ACTION_DELETE}; then
    # Previous `resolve_rebase_boundary` was for integrity only.

    return 0
  fi

  # else, ACTION_DISTANCE, ACTION_PUSH, ACTION_SAME, or none set (implies push).

  local prev_head_sha
  prev_head_sha="$(git_HEAD_commit_sha)"

  sort_and_sign_commits_with_prompt_maybe "${REBASE_BOUNDARY}" "${already_sorted}"

  local curr_head_sha
  curr_head_sha="$(git_HEAD_commit_sha)"

  if [ "${curr_head_sha}" != "${prev_head_sha}" ]; then
    must_resolve_tag_commit_and_curr_version \
      "${TAG_COMMIT_ARG}" "${VERSION_ARG}" \
      "${remote_name}" "${remote_branch}" \
      "${remote_head_sha}" "${UPSTREAM_ARG}" \
      || exit_1
  fi
}

# ***

sort_and_sign_commits_with_prompt_maybe () {
  local rebase_boundary="$1"
  local already_sorted="$2"

  if [ -z "${rebase_boundary}" ]; then
    # Already sorted and signed.

    return 0
  fi

  if git_is_same_commit "${rebase_boundary}" "HEAD"; then

    return 0
  fi

  if is_sorted_and_signed_or_gpw_disabled "${rebase_boundary}"; then

    return 0
  fi

  if prompt_user_to_sort_and_sign_commits "${rebase_boundary}" "${already_sorted}"; then
    # Run in subshell so this command doesn't exit if rebase_boundary
    # is HEAD (nothing to resort/sign).
    # - This fcn. calls must_confirm_shares_history_with_head and then
    #   exits 0 if starting_ref → HEAD (because no-op); or
    #   exits 1 if ahead of HEAD, or diverged.
    #   - Propagate nonzero exit so user can solve
    # CXREF: ~/.kit/git/git-put-wise/lib/common_put_wise.sh
    ( resort_and_sign_commits_before_push_unless_unnecessary "${rebase_boundary}" \
        ${_enable_gpg_sign:-true} \
    ) || exit_1
  fi
}

# ***

is_sorted_and_signed_or_gpw_disabled () {
  local rebase_boundary="$1"

  if ! is_git_put_wise_sort_and_sign_enabled; then
    # Means PW_OPTION_SKIP_REBASE=true, or git-put-wise not found.

    return 0
  fi

  if [ -z "${rebase_boundary}" ]; then
    # put_wise_identify_rebase_boundary_and_remotes set rebase_boundary to
    # empty string if rebase boundary could not be identified but all
    # commits are sorted & signed. Or if PW_OPTION_SKIP_REBASE=true.

    return 0
  fi

  if [ "${rebase_boundary}" = "${PUT_WISE_REBASE_ALL_COMMITS:-ROOT}" ]; then
    # If put_wise_identify_rebase_boundary_and_remotes fails,
    # resolve_rebase_boundary uses the magic "ROOT" gitref to
    # indicate that user may want to sort & sign all commits.

    return 1
  fi

  # ***

  local enable_gpg_sign=true

  # CXREF: ~/.kit/git/git-put-wise/lib/common_put_wise.sh
  local gpg_sign
  if ! gpg_sign="$( \
    insist_print_gpg_sign_arg ${enable_gpg_sign} ${_insist_signing_key:-false}
  )"; then
    >&2 echo "GAFFE: Unreachable path [is_sorted_and_signed_or_gpw_disabled]"

    return 1
  fi

  if [ -z "${gpg_sign}" ]; then
    enable_gpg_sign=false
  fi

  # ***

  # Verify rebase_boundary. Called fcn. echoes rebase_boundary, or prints "HEAD".
  must_confirm_shares_history_with_head "${rebase_boundary}" > /dev/null \
    || exit_1

  # Sets already_sorted=true and returns 1 if sorted but not signed;
  # Or sets already_sorted=false and returns 1 if not sorted; or
  # returns 0 if sorted, and signed if requested, since rebase_boundary.
  # - Also prints "✓ Verified ..." message, if either or both verified.
  # CXREF: ~/.kit/git/git-put-wise/lib/common_put_wise.sh
  already_sorted=false
  if is_already_sorted_and_signed "${rebase_boundary}" "${enable_gpg_sign}" \
  ; then

    return 0
  fi

  return 1
}

# ***

prompt_user_to_sort_and_sign_commits () {
  local rebase_boundary="$1"
  local already_sorted="$2"

  local nor_sorted=""
  local sort_and=""
  if ! ${already_sorted}; then
    nor_sorted=" nor sorted"
    sort_and="sort & "
  fi

  echo "You have not signed${nor_sorted} commits"

  local rev_list_commits
  rev_list_commits=$(print_git_rev_list_commits "${rebase_boundary}")

  local n_commits
  n_commits="$(git rev-list --count ${rev_list_commits})"

  local n_commits_inflector=""
  [ ${n_commits} -eq 1 ] || n_commits_inflector="s"

  local commit_cnt="${n_commits} commit${n_commits_inflector}"

  if [ "${rebase_boundary}" != "${PUT_WISE_REBASE_ALL_COMMITS:-ROOT}" ]; then
    echo "- We suggest rebasing since this commit: ${rebase_boundary} (${commit_cnt})"
  else
    echo "- We suggest rebasing *everything* (${commit_cnt}) because no rebase boundary identified"
  fi

  # echo "- Those with “${SCOPING_PREFIX}” and “${PRIVATE_PREFIX}” commit messages"
  # E.g., "Would you like to sign commits now?", and
  #   "Would you like to sort & sign commits now?"
  local msg="Would you like to ${sort_and}sign commits now"

  local THE_CHOICE
  ask_yesnoskip_maybe "${msg}" "Y"

  [ $? -ne 0 ] && exit_1 || true

  [ "${THE_CHOICE}" != "y" ] && return 1 || return 0
}

# ***

resolve_rebase_boundary () {
  # Use put-wise-push to determine rebase boundary.
  # - This fails if version tag found after rebase boundary,
  #   unless PW_OPTION_ORPHAN_TAGS=true.

  local skip_integrity_checks=false
  if ${ACTION_CHECK} \
    || ${ACTION_CURRENT} \
    || ${ACTION_DELETE} \
    || ${ACTION_DISTANCE} \
    || ${ACTION_SAME} \
  ; then
    skip_integrity_checks=true
  fi
  # else, ACTION_PUSH, or none set (which implies push).

  # These vars are set by the next fcn. (aka local abuse):
  local branch_name=""
  local local_release=""
  local remote_release=""
  local remote_liminal=""
  local remote_protected=""
  local remote_current=""
  local remote_name=""
  local rebase_boundary=""
  already_sorted=false
  already_signed=false
  if put_wise_identify_rebase_boundary_and_remotes \
    "${_action_desc:-bump}" \
    "${_inhibit_exit_if_unidentified:-true}" \
    "${skip_integrity_checks}" \
  ; then
    REBASE_BOUNDARY="${rebase_boundary}"
  else
    # Cound not identify rebase boundary, and commits not sorted/signed.
    REBASE_BOUNDARY="${PUT_WISE_REBASE_ALL_COMMITS:-ROOT}"
    >&2 echo "ALERT: Could not identify the rebase boundary"
    # Because put_wise_identify_rebase_boundary_and_remotes failed,
    # `git put-wise push` will also fail and print help messages.
    >&2 echo "- If you would like to use a custom boundary,"
    >&2 echo "  consult the put-wise push output for options:"
    >&2 echo "    git put-wise push"
    >&2 echo "- Otherwise we suggest rebasing all commits"
  fi

  PW_PUSH_REMOTE_RELEASE="${remote_release}"
}

# ***

is_put_wise_push_remote_same () {
  local remote_name="$1"
  local remote_branch="$2"

  if ! is_git_put_wise_sort_and_sign_enabled; then
    # Means PW_OPTION_SKIP_REBASE=true, or git-put-wise not found.

    return 1
  fi

  if [ "${remote_name}/${remote_branch}" != "${PW_PUSH_REMOTE_RELEASE}" ]; then

    return 1
  fi

  return 0
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

validate_and_normalize_version () {
  local tag_commit="$1"
  local remote_name="$2"
  local remote_branch="$3"
  local local_head_sha="$4"
  local remote_head_sha="$5"
  local skip_normalize="${6:-false}"

  # *** Verify version order integrity between commits before,
  #     commits after, commits elsewhere, and the tag_commit.

  # Find smallest tag between (tag_commit, HEAD] and check > new version.
  local smallest_version_from_ahead
  smallest_version_from_ahead="$( \
    git_smallest_version_tag_after "${tag_commit}"
  )"
  if ! check_version_tag_lt_later_version \
    "${VERSION_TAG}" "${smallest_version_from_ahead}" "${tag_commit}" \
  ; then

    exit_1
  fi

  # Find largest tag beween [root, tag_commit) and check < new version.
  # - Note that `git tag -l --merged ${tag_commit}^` will fail
  #   "fatal: malformed object name ${tag_commit}^" if HEAD^ is absent.
  local largest_version_from_behind
  if largest_version_from_behind="$( \
    git_largest_version_tag --merged "${tag_commit}^" 2> /dev/null
  )"; then
    if ! check_version_tag_gt_earlier_version \
      "${VERSION_TAG}" "${largest_version_from_behind}" "${tag_commit}" \
    ; then

      exit_1
    fi
  fi

  # Find largest tag outside this branch and alert when >= new version.
  # - It's not obvious how to handle this situation. The normal use case
  #   is that you'd only create version tags on a release branch, so who
  #   knows what this use case is.
  #   - We could add a prompt for this case specifically, especially
  #     given its presumed rarity, but we can also assume user will
  #     see it well enough at the next prompt.
  # - This check is probably good enough. It'll let user know if they're
  #   tagging from the wrong branch, so long as that branch doesn't
  #   already have the largest version tag. (If there was really gonna
  #   be a problem, we could count version tags --merged HEAD vs.
  #   count version tags --no-merged HEAD, but that seems like
  #   unnecessary busy work to implement.)
  local largest_version_from_elsewhere="$( \
    git_largest_version_tag --no-merged "HEAD"
  )"

  check_version_tag_gt_earlier_version \
    "${VERSION_TAG}" "${largest_version_from_elsewhere}" \
    "${_tag_commit}" "${_alert_fiver:-BWARE}" \
    || true

  # *** Verify version order integrity between local and remote repos

  # Verify tag_commit and remote/branch are in same line of work, unless:
  # - The operation is local-only (remote_name is "-"); or
  # - Skip-push is set, which means tag_commit same as remote_head_sha.
  if [ "${remote_name}" != "${BUMP_SKIP_REMOTE}" ] \
    && [ -n "${remote_head_sha}" ] \
  ; then
    if true \
      && ! git merge-base --is-ancestor ${tag_commit} ${remote_head_sha} \
      && ! git merge-base --is-ancestor ${remote_head_sha} ${tag_commit} \
    ; then
      >&2 echo "ERROR: Remote branch HEAD and target commit not in same branch"
      >&2 echo "- Check the remote (${remote_name}/${remote_branch})" \
        "and the tag commit (${tag_commit})"

      exit_1
    fi
  fi

  # ***

  # If TAG_COMMIT has version tag, verify new version applicable.
  # - Unless VERSION_ARG specified, then we already ran this check.
  if [ -n "${COMMIT_VERSION}" ] && [ -z "${VERSION_ARG}" ]; then
    if [ "${COMMIT_VERSION}" != "${VERSION_TAG}" ]; then
      insist_commit_version_and_new_version_are_not_same_type \
        "${COMMIT_VERSION}" "${VERSION_TAG}" \
          || exit_1
  fi

  # ***

  if ! ${skip_normalize} \
    && [ -n "${VERSION_ARG}" ] \
    && ! ${ACTION_CHECK} \
    && ! ${ACTION_DELETE} \
  ; then
    local normal_version
    normal_version="$(normalize_version "${VERSION_TAG}")" \
      || exit_1

    if [ "${VERSION_TAG}" != "${normal_version}" ]; then
      VERSION_TAG="${normal_version}"

      # Check again. (This fcn. used to normalize_version up top, then
      # run checks, but seems silly to prompt to normalize if there's
      # a version conflict anyway. And normalize only changes the alpha
      # part, if it's whack, so unlikely checks would pass at first,
      # then user would confirm normalize, and then checks would fail.
      validate_and_normalize_version \
        "${tag_commit}" \
        "${remote_name}" \
        "${remote_branch}" \
        "${local_head_sha}" \
        "${remote_head_sha}" \
        "${_skip_normalize:-true}"
    fi
  fi
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

# Normalize the version otherwise a tool such as poetry-dynamic-versioning
# might impress upon the build a version slightly different than what you
# set. E.g., it'll change 1.1.1-a-1 to 1.1.1-a.1.
#
# dunamai version styles:
# - PEP 440
#   https://www.python.org/dev/peps/pep-0440
# - Semantic Versioning
#   https://semver.org)
# - Haskell Package Versioning Policy
#   https://pvp.haskell.org
#
# https://github.com/mtkennerly/poetry-dynamic-versioning
# https://github.com/mtkennerly/dunamai

normalize_version () {
  local version_tag="$1"

  # `dunamai from git --style`: [--style {pep440,semver,pvp}]
  local normal_style="semver"

  if [ -f "$(git_project_root)/pyproject.toml" ]; then
    normal_style="pep440"
  fi

  # This script verifies the version using 3 mechanisms:
  # - Regex from SemVer itself.
  # - `dunamai check` (which seems to agree with the SemVer regex).
  # - `dunamai from` (which uses restricted SemVer subset and likes
  #                   to normalize otherwise valid versions).
  # We'll check all three, and print output unless all 3 agree.
  local CHECK_OUTPUT=""

  # Start with the SemVer regex.
  local semver_approved=true
  if [ "${normal_style}" = "semver" ]; then
    verify_new_version_semver_compliant "${version_tag}" \
      || semver_approved=false
  fi

  local normal_vers
  if ! normal_vers="$( \
    normalize_version_with_style "${version_tag}" "${normal_style}" "${semver_approved}"
  )"; then
    # Call again to set CHECK_OUTPUT.
    normalize_version_with_style "${version_tag}" "${normal_style}" "${semver_approved}" > /dev/null 2>&1

    >&2 echo "BWARE: The version did not pass checks (as ‘${normal_style}’):"
    echo -e "${CHECK_OUTPUT}" | sed '/^$/d' | >&2 sed 's/^/  /'

    if [ "${normal_vers}" != "${version_tag}" ]; then
      local THE_CHOICE

      if [ -n "${normal_vers}" ]; then
        if git_bump_confirm_normalize "${version_tag}" "${normal_vers}" "${normal_style}"; then
          [ -n "${THE_CHOICE}" ] || return 1

          version_tag="${normal_vers}"
        fi
      fi
    fi
  fi

  printf "%s" "${version_tag}"
}

# NOTED: `dunamai from` limits to a SemVer subset, e.g.,
#
#   $ dunamai check --style semver 6.1.1-123-a.1 && echo YES
#   YES
#
#   $ git tag v6.1.1-123-a.1
#
#   $ dunamai from git --style semver
#   The pattern did not match any tags
#   ...
#
# - It's likely that dunamai-check works same as SemVer regex,
#   or at least it seems so anecdotally.
#
# NOTED: On the other hand, `dunamai from` can be helpful for
#        malformed versions, e.g.,
#
#   $ dunamai check --style semver 1.0.0-alpha.001
#   Version '1.0.0-alpha.001' does not conform to the Semantic Versioning style
#
#   $ git tag v1.0.0-alpha.001
#
#   $ dunamai from git --style semver
#   1.0.0-alpha.1
#
# NOTED: `dunamai from` truncates the metadata build, e.g.,
#
#   1.0.0-alpha+001                 → 1.0.0-alpha
#   1.0.0-beta+exp.sha.5114f85      → 1.0.0-beta
#   1.0.0+20130313144700            → 1.0.0
#   1.0.0+21AF26D3----117B344092BD  → 1.0.0
#
# REMEM: dunamai-from requires v-prefix.
#
# - BWARE: But (strangely) dunamai-check complains if v-prefixed.
#
#   - README says: "the 'v' prefix on the tag is required,
#                   unless you specify a custom tag pattern."

normalize_version_with_style () {
  local orig_version="$1"
  local normal_style="$2"
  local semver_approved="$3"

  local DUNAMAI_PREFIX="v"

  # Strip user prefix (default empty, but could be anything, e.g.,
  # tig project uses 'tig-' prefix.
  local prefixed_version="${orig_version}"
  if [ "${orig_version}" = "${orig_version#${GITNUBS_PREFIX:v}}" ]; then
    # Dunamai-from requires specifically a "v" prefix.
    prefixed_version="${DUNAMAI_PREFIX}${orig_version}"
  fi

  # ***

  local dunamai_check_approved=true

  # Dunamai-check requires there not be a "v" or any prefix.
  if ! dunamai check --style "${normal_style}" \
    "${prefixed_version#${DUNAMAI_PREFIX}}" 2> /dev/null\
  ; then
    dunamai_check_approved=false

    CHECK_OUTPUT="${CHECK_OUTPUT}\n$(highlight_fail "✗ dunamai-check rejects ‘${orig_version}’")"
  else
    CHECK_OUTPUT="${CHECK_OUTPUT}\n$(highlight_pass "✓ dunamai-check affirms ‘${orig_version}’")"
  fi

  # ***

  local temp_dir
  temp_dir="$(mktemp -d -- "/tmp/$(basename -- "$0")-XXXXXXX")" \
    || ( >&2 echo "ERROR: \`mktemp\` failed" && exit_1 )

  cd "${temp_dir}"

  git init . -q
  # When run from CI, Git user default unset, so use fake vals.
  git config user.email foo
  git config user.name foo
  touch foo
  git add foo
  # When run from CI, Git user unset, so use placeholder.
  git commit -m foo -q
  git tag "${prefixed_version}"

  # The two styles we support:
  #  dunamai from git --style semver
  #  dunamai from git --style pep440

  local discontented=false

  local warning
  warning="$(dunamai from git --style "${normal_style}" 2>&1 > /dev/null)" \
    || true

  if [ -z "${warning}" ]; then
    local dunamai_vers
    dunamai_vers="$(dunamai from git --style "${normal_style}")"

    if [ "${orig_version}" != "${dunamai_vers}" ]; then
      discontented=true

      if ${dunamai_check_approved} \
        && echo "${orig_version}" | sed 's/+.*$//' | grep -q "^${dunamai_vers}\$" \
      ; then
        # Dunamai removes +build.metadata
        CHECK_OUTPUT="${CHECK_OUTPUT}\n$( \
          highlight_pass "✓ dunamai-from rms +bld ‘${orig_version}’ to ‘${dunamai_vers}’"
        )"

        # Don't ask user to truncate build metadata.
        printf "%s" "${orig_version}"
      else
        # Dunamai normalizes, e.g., 2.0.1-alpha1 → 2.0.1-alpha.1
        CHECK_OUTPUT="${CHECK_OUTPUT}\n$( \
          highlight_mid "? dunamai-from converts ‘${orig_version}’ to ‘${dunamai_vers}’"
        )"

        printf "%s" "${dunamai_vers}"
      fi
    else
      printf "%s" "${dunamai_vers}"
    fi
  else
    discontented=true

    CHECK_OUTPUT="${CHECK_OUTPUT}\n$(highlight_fail "✗ dunamai-from dislikes ‘${orig_version}’")"

    if ! ${semver_approved} \
      || ${BMP_DUNAMAI_WINS:-false} \
      || [ "${normal_style}" != "semver" ] \
    ; then
      >&2 echo "ERROR: dunamai cannot extract ‘${orig_version}’ as ‘${normal_style}’:"
      >&2 echo "$(echo "${warning}" | sed 's/^/  /')"
    fi

    printf "%s" "${orig_version}"
  fi

  cd - > /dev/null

  # DEV: Uncomment to leave temp dir:
  #
  #   >&2 echo "${temp_dir}"
  #   return 1

  command rm -rf -- "${temp_dir}"

  ! ${discontented}
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

attr_bold () {
  printf "\033[1m"
}

attr_reset () {
  printf "\033[0m"
}

highlight_fail () {
  printf "$(fg_pink)$@$(attr_reset)"
}

highlight_mid () {
  printf "$(fg_lightorange)$@$(attr_reset)"
}

highlight_pass () {
  printf "$(fg_lightcyan)$@$(attr_reset)"
}

fg_lightcyan () {
  printf "\033[96m"
}

fg_lightorange () {
  printf "\033[38;2;255;175;95m"
}

fg_pink () {
  printf "\033[38;2;255;135;175m"
}

# +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ #

_STAGED=false
_WIPPED=false

sh_err_trap_user_hook () {
  local normal_exit="$1"
  local return_value="$2"

  git_pop_wipped_wip_commit_maybe
  git_undo_staged_wip_commit_maybe
}

# ***

main () {
  # Using errexit makes for a more robust script, and is esp. important
  # for unattended CI runs.
  set -e

  # Load: set_traps, clear_traps, exit_0, exit_1, os_is_macos.
  . "$(dirname -- "$(realpath -- "$0")")/../deps/sh-err-trap/lib/err-trap.sh"

  set_traps

  source_deps

  GITNUBS_LENGTH_SHORT_SHA="${GITNUBS_LENGTH_SHORT_SHA:-7}"

  git_bump_tag_vers_push "$@"

  clear_traps
}

if [ "$0" = "${BASH_SOURCE[0]}" ]; then
  main "$@"
fi

